# Keep generated site documents stable across Windows and GitHub Pages.
.gitattributes text eol=lf
*.py text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.tex text eol=lf
*.srt text eol=lf
*.vtt text eol=lf
frontier-safety/data/*.json text eol=lf
frontier-safety/data/**/*.json text eol=lf
frontier-safety/social/*.txt text eol=lf

# Downloadable binary artifacts are byte-verified; do not normalize them.
*.pdf binary
artifacts/*.zip binary

# Spatial world packages are byte-receipted: no EOL conversion, ever.
art/spatial/** -text
plugins/data/** text eol=lf

# raw-native WebAssembly release files are pinned by SHA-256 in plugins/raw.mjs: no EOL conversion.
media/raw-native/wasm-*/** -text
# raw-native's web GPU host, pinned by SHA256SUMS in its directory: no EOL conversion.
media/raw-native/web-*/** -text

# The vendored Learn copy is checked byte for byte against VENDOR.json.
system/vendor/learn/** -text
# The vendored superstack contract is pinned by SHA-256; CRLF would break the pin.
system/media-engine/contracts.mjs text eol=lf
tools/superstack.py text eol=lf
tests/superstack/** text eol=lf

# tests/superstack/SHA256SUMS pins the vendored superstack implementations by the
# SHA-256 of their exact bytes (tools/superstack.py, and system/media-engine/
# contracts.mjs checked as superstack.mjs); SUPERSTACK.sha256 beside each copy pins
# the same bytes, and tests/superstack/vectors/MANIFEST.json pins every vector.
# The `text eol=lf` rules above write LF, but Git still converts these files on
# commit and checkout. `-text` turns conversion off for exactly these paths, so the
# bytes on disk are the committed blob under any core.autocrlf setting. Later lines
# win. media/raw-native/wasm-*/** is already -text above.
tests/superstack/SHA256SUMS -text
tests/superstack/vectors/*.json -text
tools/superstack.py -text
tools/SUPERSTACK.sha256 -text
system/media-engine/contracts.mjs -text
system/media-engine/SUPERSTACK.sha256 -text
# Release media bundles (raw-native media render) are hashed in their media.json: no EOL conversion.
media/releases/** -text
