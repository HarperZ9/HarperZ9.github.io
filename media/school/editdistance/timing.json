[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.563,
  "end": 10.048,
  "text": "Dynamic programming: remember what you already worked out.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 11.611,
  "end": 15.569,
  "text": "Some problems are made of smaller problems that keep coming back.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 16.402,
  "end": 20.36,
  "text": "Tonight Rerun learns to solve each one once and write the answer down.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 23.485,
  "end": 25.332,
  "text": "How different are two words?",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 26.166,
  "end": 33.818,
  "text": "Count the fewest single-letter edits that turn one into the other: put a letter in, take one out, or change one.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 35.38,
  "end": 41.449,
  "text": "Kitten becomes sitting in 3: change the k to an s, the e to an i, and add a g.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 42.282,
  "end": 44.921,
  "text": "This count is called the edit distance.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 48.046,
  "end": 51.213,
  "text": "The obvious way is to try everything.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 52.046,
  "end": 59.962,
  "text": "Look at the last letters: either delete one, insert one, or match or change them, and work out the rest of each case the same way.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 61.524,
  "end": 65.482,
  "text": "That works, but the same smaller questions come up again and again.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 66.316,
  "end": 72.648,
  "text": "For kitten and sitting, the recursion made 29,737 calls.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "predict": 0,
  "start": 73.481,
  "end": 79.286,
  "text": "Two phrases of thirteen characters. How many calls does trying every way make?",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 2,
  "start": 81.786,
  "end": 88.646,
  "text": "For intention and execution, 2,193,844.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 91.772,
  "end": 106.548,
  "text": "For two phrases of 13 characters, it made 2,114,900,428 calls and took 11,327 milliseconds on this computer.",
  "syllables": 56,
  "seconds": 14.776,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 107.381,
  "end": 113.186,
  "text": "Each extra letter multiplies the work by about five and a half, and the factor keeps rising.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 114.748,
  "end": 122.4,
  "text": "Yet there are only 196 different questions in the whole problem, the big one included.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 123.234,
  "end": 125.081,
  "text": "The rest is repetition.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 128.206,
  "end": 137.177,
  "text": "So write each answer down once, in a table: one row for each letter of the first word plus one for the empty start, and the same for the columns.",
  "syllables": 34,
  "seconds": 8.971,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 138.74,
  "end": 145.6,
  "text": "Each square needs only three others: the one above, the one to its left, and the one diagonally above and left.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 146.433,
  "end": 150.127,
  "text": "Fill them in order and the bottom corner is the answer.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 2,
  "start": 150.961,
  "end": 158.085,
  "text": "For kitten and sitting, 56 squares instead of 29,737 calls.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 159.648,
  "end": 169.146,
  "text": "Robert Wagner and Michael Fischer published this table for strings in 1974, and others found it independently.",
  "syllables": 36,
  "seconds": 9.499,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 172.272,
  "end": 175.438,
  "text": "The table also says which edits to make.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 176.271,
  "end": 183.131,
  "text": "From the bottom corner, step back to whichever neighbour gave its value, and each step is one edit or one match.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 184.694,
  "end": 189.707,
  "text": "Halve the beach and half the beach are 2 apart: drop the v, and change the e to an f.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 192.833,
  "end": 197.318,
  "text": "Why not just walk along both strings and fix each difference as you meet it?",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 198.152,
  "end": 198.943,
  "text": "We tried that.",
  "syllables": 3,
  "seconds": 0.792,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 2,
  "start": 199.777,
  "end": 201.888,
  "text": "It got both classic word pairs right.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 203.45,
  "end": 211.102,
  "text": "It was wrong on all 6 of our guide sentences, and too high on 576 of 1,000 random pairs.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 211.936,
  "end": 216.157,
  "text": "A test with only the textbook examples would have passed it.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 219.283,
  "end": 227.462,
  "text": "Richard Bellman chose the name dynamic programming around 1950, for problems solved in stages.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 228.296,
  "end": 236.475,
  "text": "Today it means: when a big problem is built from smaller ones that overlap, solve each smaller one once and keep the answer.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 238.038,
  "end": 241.468,
  "text": "The same idea finds shortest routes and decodes speech.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 244.593,
  "end": 248.287,
  "text": "When the same question keeps coming back, write the answer down.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 249.85,
  "end": 250.378,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
