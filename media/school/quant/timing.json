[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.734,
  "end": 6.79,
  "text": "Quantisation.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 7.715,
  "end": 9.298,
  "text": "Fewer bits per number.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 11.032,
  "end": 15.517,
  "text": "Every number in our model is stored in 32 bits.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 16.442,
  "end": 20.928,
  "text": "Big models have billions of numbers, so the memory adds up fast.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 2,
  "start": 21.853,
  "end": 27.394,
  "text": "Tonight Tallow stores the weights in fewer bits and measures what the model loses.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 30.862,
  "end": 33.237,
  "text": "Think of a painter with fewer paints.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 34.162,
  "end": 37.856,
  "text": "With 255 shades a picture looks smooth.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 2,
  "start": 38.781,
  "end": 40.891,
  "text": "With 15, you start to see bands.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 3,
  "start": 41.816,
  "end": 43.663,
  "text": "With 3, you see mostly bands.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 45.397,
  "end": 48.564,
  "text": "Quantising a table of weights is the same move.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 49.489,
  "end": 55.557,
  "text": "Pick a scale, divide every number by it, and round to the nearest of a few levels.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 2,
  "start": 56.482,
  "end": 60.704,
  "text": "At 4 bits our scheme has 15 levels; at 2 bits, only 3.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 62.438,
  "end": 66.396,
  "text": "To use the table again, multiply back by the scale.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 67.321,
  "end": 72.862,
  "text": "Every number comes back to its nearest level, off by up to half a step.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 76.33,
  "end": 82.926,
  "text": "Our model takes 83,456 bytes in 32-bit numbers.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 83.851,
  "end": 93.35,
  "text": "At 4 bits, with one scale for each output of each table, it takes 15,376: 18 percent of the size.",
  "syllables": 36,
  "seconds": 9.499,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 96.818,
  "end": 101.568,
  "text": "Score every version on the same 1,024 held-out rows.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 102.493,
  "end": 106.187,
  "text": "The full model's loss is 0.6676.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 107.921,
  "end": 113.462,
  "text": "At 8 bits per number, one scale per output: 0.6677.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "predict": 0,
  "start": 114.387,
  "end": 118.081,
  "text": "Four bits instead of thirty-two. How much worse is the loss?",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 120.581,
  "end": 122.955,
  "text": "At 6: 0.6685.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 123.88,
  "end": 126.519,
  "text": "At 4: 0.6754.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 3,
  "start": 127.444,
  "end": 130.082,
  "text": "At 3: 0.7249.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 4,
  "start": 131.007,
  "end": 134.437,
  "text": "At 2 bits: 3.48, and the model is broken.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 136.171,
  "end": 144.087,
  "text": "With one scale for each whole table instead of each output, it breaks sooner: 1.59 already at 3 bits.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 147.555,
  "end": 151.249,
  "text": "One scale has to cover a table's biggest number.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 152.174,
  "end": 159.562,
  "text": "If a few numbers are much bigger than the rest, the steps get wide, and every small number is rounded coarsely.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 161.296,
  "end": 167.893,
  "text": "Quantise one table at a time to 4 bits, with one scale for the whole table, and see which one hurts.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 168.818,
  "end": 178.58,
  "text": "The readout, the table that turns the model's last list of numbers into word scores, costs the most: 0.0276 nats on its own.",
  "syllables": 37,
  "seconds": 9.763,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 180.314,
  "end": 192.188,
  "text": "Tim Dettmers and colleagues found in 2022 that in large models, once the activations are stored in 8 bits too, the trouble comes from a few huge values in them.",
  "syllables": 45,
  "seconds": 11.873,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 1,
  "start": 193.113,
  "end": 196.807,
  "text": "Activations are the numbers flowing between tables.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 2,
  "start": 197.732,
  "end": 202.745,
  "text": "We left those in full precision here, so that part of the story does not show.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 206.213,
  "end": 211.754,
  "text": "Rounding each number on its own throws away the fact that they work together.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 212.679,
  "end": 225.344,
  "text": "GPTQ, from Elias Frantar and colleagues in 2023, rounds the numbers of a table one input column at a time and nudges the ones not yet rounded to make up for the error.",
  "syllables": 48,
  "seconds": 12.665,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 2,
  "start": 226.269,
  "end": 230.49,
  "text": "It uses a small sample of text to see which errors matter.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 232.225,
  "end": 239.613,
  "text": "At 4 bits with one scale per output, plain rounding raises the loss by 0.0078.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 240.538,
  "end": 245.815,
  "text": "GPTQ raises it by 0.0028, roughly a third as much.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 247.549,
  "end": 248.868,
  "text": "It is not magic.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 1,
  "start": 249.793,
  "end": 255.334,
  "text": "At 2 bits with one scale per table, both versions are broken, and GPTQ comes out worse.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 258.802,
  "end": 263.552,
  "text": "Fewer bits per number is how large models fit on smaller machines.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 264.477,
  "end": 278.725,
  "text": "Our model has only 83,456 bytes of numbers, and large ones behave differently, so how few bits you can get away with has to be measured on the model you have.",
  "syllables": 54,
  "seconds": 14.248,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 280.459,
  "end": 286.0,
  "text": "Next, in the cannery: the sums these tables are used for, and how a chip does them fast.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 286.925,
  "end": 287.452,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
