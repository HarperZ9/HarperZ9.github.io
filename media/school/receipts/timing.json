[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.779,
  "end": 8.681,
  "text": "Case study: a score that carries its receipt.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 10.46,
  "end": 14.682,
  "text": "In lesson E24 we saw a check that could be fooled.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 15.631,
  "end": 24.338,
  "text": "Tonight Rerun opens a score that comes with its own evidence, checks it from scratch, and finds out exactly what that evidence proves.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 27.896,
  "end": 30.27,
  "text": "Flywheel is our evaluation tool.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 31.219,
  "end": 42.037,
  "text": "In this demonstration a data owner runs an approved job on private questions, and the job writes one row per question: the answer given and whether it was right.",
  "syllables": 41,
  "seconds": 10.818,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 43.816,
  "end": 46.455,
  "text": "The result says 40 of 50.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 47.403,
  "end": 60.86,
  "text": "Beside it sits a receipt: a hash of the rows, a tree of hashes over every row, the hash of the approved job, a hash of the approval record, and a signature over the whole body.",
  "syllables": 51,
  "seconds": 13.456,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 64.418,
  "end": 70.486,
  "text": "A hash is a fingerprint of bytes: change one byte and the fingerprint changes completely.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 72.265,
  "end": 75.959,
  "text": "So we counted the rows ourselves: 40 of 50.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "predict": 0,
  "start": 76.908,
  "end": 82.977,
  "text": "Flip any one byte of the rows file. Does the check catch every flip, most of them, or few?",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 85.477,
  "end": 92.601,
  "text": "Then we recomputed, in this page's own code, every fingerprint the files let us check, nine in all.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 2,
  "start": 93.549,
  "end": 96.452,
  "text": "Each matched the published value exactly.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 3,
  "start": 97.401,
  "end": 104.261,
  "text": "The approval record's hash and the model and data commitments cannot be recomputed from the bundle.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 107.819,
  "end": 116.262,
  "text": "We flipped every byte of every file, one at a time, 10,960 tampered copies in all.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 117.211,
  "end": 124.862,
  "text": "In the rows file, all 2,892 of 2,892 were caught.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 126.641,
  "end": 133.502,
  "text": "In the receipt itself, 5,663 of 5,744.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 134.45,
  "end": 146.06,
  "text": "The 81 missed bytes sit in two fields outside the signed body, the envelope's schema name and the signature's key name, which Flywheel's verifier never reads.",
  "syllables": 44,
  "seconds": 11.609,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 147.009,
  "end": 154.133,
  "text": "The permissions file was caught 0 times in 108: the job's hash leaves it out on purpose.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 157.691,
  "end": 161.121,
  "text": "A sneakier edit: swap the right and wrong marks on two rows.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 162.069,
  "end": 166.291,
  "text": "The count is still 40, so a check on the score alone passes.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 168.07,
  "end": 169.653,
  "text": "The fingerprints do not.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 170.602,
  "end": 174.56,
  "text": "The rows' hash and the tree both change, and the receipt no longer matches.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 178.118,
  "end": 179.173,
  "text": "Now the hard case.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 180.122,
  "end": 186.454,
  "text": "Someone signs a lie: they mark one wrong row as right, rebuild every fingerprint and sign again.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 188.233,
  "end": 194.566,
  "text": "If we accept their key, every hash check passes, and the receipt is perfectly consistent.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 195.514,
  "end": 201.319,
  "text": "If we insist on a key we trusted before, the signature check catches the swap.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 2,
  "start": 202.268,
  "end": 208.6,
  "text": "But if the liar holds that trusted key, only the true answers, revealed afterwards, catch it.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 210.379,
  "end": 216.712,
  "text": "A receipt proves the bytes have not changed since they were signed, and which key signed them.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 1,
  "start": 217.661,
  "end": 221.355,
  "text": "It cannot prove the rows were true when they were written.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 2,
  "start": 222.303,
  "end": 227.844,
  "text": "That needs a check against the truth, like the exact checker in lesson E24.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 231.402,
  "end": 232.985,
  "text": "One more thing turned up.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 233.934,
  "end": 238.947,
  "text": "Flywheel's verifier never recomputes the receipt's own identifier.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 2,
  "start": 239.896,
  "end": 251.769,
  "text": "Flywheel's own test of a consistent lie rebuilds and signs everything except that identifier, and its verifier still says the receipt matches until the answers are revealed.",
  "syllables": 45,
  "seconds": 11.873,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 253.548,
  "end": 255.923,
  "text": "Our page checks the identifier too.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 256.872,
  "end": 265.579,
  "text": "That is a gap worth closing in Flywheel's verifier, and it is the point of a receipt anyone can recheck: an outside check found it.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 269.137,
  "end": 274.942,
  "text": "Recount the rows, recompute the fingerprints, and remember what a signature cannot see.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 276.721,
  "end": 277.248,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
