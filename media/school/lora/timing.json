[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.872,
  "end": 7.191,
  "text": "LoRA and fine-tuning.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 8.189,
  "end": 10.3,
  "text": "A small rudder for a big boat.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 12.172,
  "end": 17.185,
  "text": "A trained model can be taught a new job by training it a little more.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 18.183,
  "end": 19.502,
  "text": "That is fine-tuning.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 2,
  "start": 20.501,
  "end": 30.263,
  "text": "Tonight we teach the attention model one new habit, first by changing every number, then by bolting on something small and changing only that.",
  "syllables": 37,
  "seconds": 9.763,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 34.007,
  "end": 40.603,
  "text": "The new habit: things keep their look. \"The boat was bright.\" Maybe a sentence or two about something else.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 41.601,
  "end": 44.504,
  "text": "Then \"the boat was\", and the answer is bright again.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 46.375,
  "end": 53.499,
  "text": "In the guides' usual sentences a thing never keeps its look; the adjective is drawn fresh every time.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 54.498,
  "end": 62.677,
  "text": "So the trained model gets the answer right only 15 percent of the time, about what guessing among six looks would give.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 64.549,
  "end": 66.66,
  "text": "Our yardstick is the answer word.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 67.658,
  "end": 76.101,
  "text": "Once the thing is named again, the right look is certain, so a model that has learned the habit gets it right every time.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 79.845,
  "end": 88.552,
  "text": "First, the plain way: train all 20,864 numbers on the new sentences for 1,500 steps.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 90.423,
  "end": 93.59,
  "text": "It learns the habit: 99 percent right.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 95.461,
  "end": 97.044,
  "text": "But look at the old job.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 1,
  "start": 98.043,
  "end": 103.056,
  "text": "Before, the model got look-back words right 99 percent of the time.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 2,
  "start": 104.054,
  "end": 105.637,
  "text": "After, 30 percent.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 3,
  "start": 106.636,
  "end": 112.704,
  "text": "It trained only on the new sentences, and it forgot much of the old skill on the way.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 116.448,
  "end": 122.516,
  "text": "LoRA, from Hu and colleagues in 2021, leaves the trained numbers alone.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 123.514,
  "end": 132.485,
  "text": "Beside a table of weights it adds two thin strips: one with a number for every input, one with a number for every output.",
  "syllables": 34,
  "seconds": 8.971,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 2,
  "start": 133.484,
  "end": 140.08,
  "text": "Multiply them together and you get a full-sized table of changes, added to the frozen one.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 141.952,
  "end": 151.714,
  "text": "The table we are looking at is the second floor's query, key and value table, 32 by 96: 3,072 numbers.",
  "syllables": 37,
  "seconds": 9.763,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 152.712,
  "end": 156.67,
  "text": "One pair of strips is 32 plus 96 numbers.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 157.668,
  "end": 158.724,
  "text": "That is rank 1.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 3,
  "start": 159.722,
  "end": 161.569,
  "text": "Rank 2 is two pairs, and so on.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 163.441,
  "end": 170.565,
  "text": "One strip starts at zero, so at the first step the model is exactly the trained one, number for number.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 1,
  "start": 171.563,
  "end": 174.993,
  "text": "We checked: every output the same, bit for bit.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 178.737,
  "end": 184.014,
  "text": "Fit rank-1 strips to the four attention tables: 384 numbers.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 185.012,
  "end": 187.387,
  "text": "Rank 8: 3,072.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "predict": 0,
  "start": 188.385,
  "end": 198.939,
  "text": "Rank-1 strips on the attention tables: 384 numbers out of 20,864. How much of the habit do they learn?",
  "syllables": 40,
  "seconds": 10.554,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 2,
  "start": 201.439,
  "end": 211.201,
  "text": "The answer word comes out right 18 percent of the time at rank 1, hardly better than before, 24 at rank 4, and 61 at rank 8.",
  "syllables": 37,
  "seconds": 9.763,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 213.073,
  "end": 227.321,
  "text": "Strips on the feed-forward and readout tables too: 36 percent at rank 1, 82 at rank 4, and 92 at rank 8, with 6,768 numbers, 32 percent of the model's.",
  "syllables": 54,
  "seconds": 14.248,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 229.193,
  "end": 232.359,
  "text": "Something odd happened along the way.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 1,
  "start": 233.357,
  "end": 239.426,
  "text": "Every adapter learned to name the thing again, 98 percent at rank 1.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 2,
  "start": 240.424,
  "end": 249.659,
  "text": "Carrying its look across the sentence was the hard part, and after 1,500 steps the thinner attention strips still had not got it.",
  "syllables": 35,
  "seconds": 9.235,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 3,
  "sentence": 0,
  "start": 251.531,
  "end": 253.642,
  "text": "And the seeds often disagree.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 3,
  "sentence": 1,
  "start": 254.64,
  "end": 262.028,
  "text": "At rank 2, with strips on the feed-forward and readout tables too, the three runs got 14 to 75 percent.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 265.771,
  "end": 267.882,
  "text": "Why should a few strips be enough?",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 268.88,
  "end": 276.268,
  "text": "Hu and colleagues guessed that the change fine-tuning makes has a low rank: most of it points in a few directions.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 2,
  "start": 277.266,
  "end": 280.696,
  "text": "We can check that here, on the change a full fine-tune made.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 282.568,
  "end": 287.845,
  "text": "For the readout table, the top direction holds 69 percent of the change.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 288.843,
  "end": 293.329,
  "text": "For the attention table on the second floor, 26 percent.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 2,
  "start": 294.327,
  "end": 298.549,
  "text": "A random change of that shape would put only 7 percent there.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 3,
  "start": 299.547,
  "end": 301.394,
  "text": "So the change is lopsided.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 303.266,
  "end": 304.057,
  "text": "But not thin.",
  "syllables": 3,
  "seconds": 0.792,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 1,
  "start": 305.056,
  "end": 311.916,
  "text": "To hold nine tenths of it, that attention table needs 10 or 11 of its 32 directions.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 2,
  "start": 312.914,
  "end": 322.149,
  "text": "Cut every table's change down to its best rank 1 and the answer is right only 19 percent of the time; at rank 8, 74.",
  "syllables": 35,
  "seconds": 9.235,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 3,
  "sentence": 0,
  "start": 324.021,
  "end": 327.451,
  "text": "So on this model and this job, the claim is partly true.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 3,
  "sentence": 1,
  "start": 328.449,
  "end": 332.934,
  "text": "The change leans toward a few directions, and it still needs more than a few.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 336.678,
  "end": 343.802,
  "text": "Every method here trained only on the new sentences, and every one forgot some of the old job.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 345.674,
  "end": 354.117,
  "text": "Rank-1 strips on attention forgot least: look-back words still 70 percent right, against 30 after changing everything.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 355.115,
  "end": 356.962,
  "text": "They also learned least.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 2,
  "start": 357.96,
  "end": 364.293,
  "text": "Strips on the feed-forward and readout tables too forgot about as much as changing everything.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 0,
  "start": 366.164,
  "end": 380.94,
  "text": "Biderman and colleagues found a similar pattern in 2024, on models with billions of numbers: LoRA learned less of a new field than full fine-tuning and forgot less of the old, and more strips meant more forgetting.",
  "syllables": 56,
  "seconds": 14.776,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 3,
  "sentence": 0,
  "start": 382.812,
  "end": 388.353,
  "text": "We did not try the usual cure, mixing some old sentences into the new training.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 3,
  "sentence": 1,
  "start": 389.351,
  "end": 391.99,
  "text": "That is a lesson for another night.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 395.733,
  "end": 405.496,
  "text": "Strips need little memory to train, are small to store and easy to take off again, so one trained model can carry many jobs, one set of strips each.",
  "syllables": 37,
  "seconds": 9.763,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 406.494,
  "end": 412.035,
  "text": "How many strips a job needs, Hu's team expects, depends on the job; we tried only one.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 413.906,
  "end": 418.92,
  "text": "Next, at the prism: how sure we can be of a number like the ones tonight.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 1,
  "start": 419.918,
  "end": 420.446,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
