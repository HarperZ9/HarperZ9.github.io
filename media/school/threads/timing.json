[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.747,
  "end": 7.33,
  "text": "Threads, workgroups and memory.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 9.076,
  "end": 12.243,
  "text": "A graphics chip does not do one sum very fast.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 13.174,
  "end": 16.076,
  "text": "It does thousands of small sums at the same time.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 2,
  "start": 17.008,
  "end": 23.077,
  "text": "Tonight Pylon runs the cannery where that happens, and counts every trip to the warehouse.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 26.57,
  "end": 31.583,
  "text": "The job: add two lists of numbers, element by element, into a third.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 32.514,
  "end": 37.791,
  "text": "A list of 1,048,576 numbers.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 39.538,
  "end": 44.287,
  "text": "On a graphics chip, each element gets its own worker, called a thread.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 45.219,
  "end": 50.76,
  "text": "Thread 40 reads number 40 from each list, adds them, and writes the sum to place 40.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 2,
  "start": 51.691,
  "end": 54.858,
  "text": "Every thread runs the same few lines of code.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 58.351,
  "end": 60.462,
  "text": "Threads come in crews called workgroups.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 61.393,
  "end": 67.989,
  "text": "You choose the crew size; in WebGPU a crew may hold up to 256 threads by default.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 69.736,
  "end": 76.86,
  "text": "A thread finds its element from its crew's number and its place in the crew: crew number times crew size, plus its place.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 77.792,
  "end": 81.749,
  "text": "With crews of 16, crew 2, place 8, is element 40.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 83.496,
  "end": 85.343,
  "text": "Crews come in whole numbers.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 1,
  "start": 86.274,
  "end": 92.607,
  "text": "Add 1,000 numbers with crews of 64 and you need 16 crews, 1,024 threads.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 2,
  "start": 93.538,
  "end": 99.343,
  "text": "The last 24 have nothing to do, so the code must check that its element exists.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 102.836,
  "end": 108.113,
  "text": "Get that check wrong by one, and one idle thread writes one place past the end of the list.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "predict": 0,
  "start": 109.045,
  "end": 112.211,
  "text": "If the check is off by one, does the program crash?",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 114.711,
  "end": 122.099,
  "text": "In a list of 40 numbers, numbered 0 to 39, element 40 has no place of its own.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 123.846,
  "end": 126.22,
  "text": "On a graphics chip that need not crash.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 127.152,
  "end": 137.178,
  "text": "The WGSL rules call it an error, but let it end quietly: the stray write may land anywhere in the same buffer, be dropped, or stop that one thread.",
  "syllables": 38,
  "seconds": 10.026,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 138.11,
  "end": 143.651,
  "text": "So the output can look right while something else in the same buffer was spoiled.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 145.397,
  "end": 153.577,
  "text": "Our checker compares every sum with a slow, careful one on the main processor, and plants guard values just past the end.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 1,
  "start": 154.508,
  "end": 160.049,
  "text": "Of 12 test cases, nine came from three kernels we broke on purpose, each run three ways.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 2,
  "start": 160.981,
  "end": 164.147,
  "text": "Together the two checks catch seven of the nine.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 3,
  "start": 165.078,
  "end": 170.619,
  "text": "The two they miss are stray writes the chip dropped, which leave every sum right.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 4,
  "start": 171.551,
  "end": 175.508,
  "text": "Only our emulator, which counts every write, sees those.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 179.002,
  "end": 190.875,
  "text": "On NVIDIA chips, each crew is split into teams of 32 threads, called warps; other chips use other team sizes, from 4 to 128, and our counts use NVIDIA's 32.",
  "syllables": 45,
  "seconds": 11.873,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 191.807,
  "end": 200.778,
  "text": "When a team reads from memory, the chip fetches whole blocks at a time; the current CUDA guide describes blocks of 32 bytes.",
  "syllables": 34,
  "seconds": 8.971,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 202.524,
  "end": 210.704,
  "text": "If the 32 threads read 32 neighbouring numbers, 4 bytes each, that is 128 bytes: 4 blocks.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 211.635,
  "end": 212.954,
  "text": "One team, a few trips.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 214.701,
  "end": 217.603,
  "text": "Now spread the reads out, every eighth number.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 1,
  "start": 218.535,
  "end": 222.493,
  "text": "The same 32 reads now touch 32 blocks, one per thread.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 225.986,
  "end": 229.416,
  "text": "Count every trip for the whole job, reads and writes.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "predict": 0,
  "start": 230.347,
  "end": 233.514,
  "text": "Reads spread eight apart. How many times the trips?",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 236.014,
  "end": 241.291,
  "text": "With neighbouring reads: 393,216 blocks.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 2,
  "start": 242.222,
  "end": 248.291,
  "text": "With reads spread eight apart: 2,228,224.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 3,
  "start": 249.222,
  "end": 256.082,
  "text": "That is 5.67 times the trips, not 8, because the writes still go to neighbouring places.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 4,
  "start": 257.014,
  "end": 259.916,
  "text": "Most of each block fetched is thrown away.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 261.663,
  "end": 268.787,
  "text": "Spreading them further changes nothing more in this model, because each thread already has a block of its own.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 272.28,
  "end": 275.71,
  "text": "These are counts from a model of the chip, not times.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 276.642,
  "end": 281.919,
  "text": "Real chips have caches that hide some of the cost, and they differ from one another.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 283.665,
  "end": 290.789,
  "text": "So the lab runs the real kernel on the chip in your own computer, if your browser allows it, and times it.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 291.721,
  "end": 301.483,
  "text": "If the time for spread-out reads is far from what the count predicts, then caches, a different team or block size, or the cost of starting the job are at work.",
  "syllables": 37,
  "seconds": 9.763,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 304.977,
  "end": 308.143,
  "text": "Thousands of small workers, in crews, fetching in blocks.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 309.074,
  "end": 313.824,
  "text": "Fast code keeps neighbouring workers on neighbouring numbers, and checks the edges.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 315.57,
  "end": 322.167,
  "text": "Next in the cannery: multiplying whole tables, and carrying trays instead of single cans.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 1,
  "start": 323.098,
  "end": 323.626,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
