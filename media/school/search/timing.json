[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.626,
  "end": 7.737,
  "text": "Search and sorting: the cost of looking.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 9.364,
  "end": 15.432,
  "text": "Looking things up and putting them in order are two of the commonest jobs a computer does.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 16.3,
  "end": 19.466,
  "text": "Tonight Rerun counts the cost, one knock at a time.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 22.719,
  "end": 28.787,
  "text": "Rerun is looking for one shell in a row of 65,536.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 29.655,
  "end": 33.876,
  "text": "The plain way is to knock on each in turn until he finds it.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 35.503,
  "end": 41.571,
  "text": "On average that took 32,921 knocks, about half the row.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 42.439,
  "end": 47.98,
  "text": "If the shell is not there, he knocks on all 65,536.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 51.232,
  "end": 54.926,
  "text": "Now suppose the shells are in order, smallest to largest.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 55.794,
  "end": 57.377,
  "text": "Knock on the middle one.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 2,
  "start": 58.244,
  "end": 62.73,
  "text": "If it is too big, the shell must be in the left half; too small, the right.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 3,
  "start": 63.597,
  "end": 65.708,
  "text": "Half the beach is gone in one knock.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 67.334,
  "end": 68.126,
  "text": "Keep halving.",
  "syllables": 3,
  "seconds": 0.792,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "predict": 0,
  "start": 68.993,
  "end": 72.951,
  "text": "Sixty-five thousand shells, in order. How many knocks at most?",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 75.451,
  "end": 83.367,
  "text": "For 65,536 shells it takes at most 17 knocks, and about 15 on average.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 86.619,
  "end": 90.049,
  "text": "Halving only works because the shells are in order.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 90.917,
  "end": 105.956,
  "text": "Try it on a jumbled row of the same size and it still stops within 17 knocks, but even in its best run it missed 65,515 of the 65,536 shells that are there.",
  "syllables": 57,
  "seconds": 15.04,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 107.583,
  "end": 110.749,
  "text": "Fewer knocks is no good if the answer is wrong.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 111.616,
  "end": 114.519,
  "text": "So first, the shells have to be put in order.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 117.772,
  "end": 126.479,
  "text": "The simplest way: pick up each shell in turn and slide it left past every bigger one, the way many people sort a hand of cards.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 128.105,
  "end": 141.034,
  "text": "On a row that is already in order, that is 65,535 comparisons for 65,536 shells, one for each shell after the first.",
  "syllables": 49,
  "seconds": 12.929,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 141.901,
  "end": 150.872,
  "text": "On a row in reverse order it is 2,147,450,880.",
  "syllables": 34,
  "seconds": 8.971,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 2,
  "start": 151.74,
  "end": 159.655,
  "text": "On a jumbled row, about 1,074,190,182.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 162.908,
  "end": 172.671,
  "text": "A better way: split the row in half, sort each half, then merge the two sorted halves by walking along both and always taking the smaller front shell.",
  "syllables": 37,
  "seconds": 9.763,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 174.297,
  "end": 177.991,
  "text": "Each half is sorted the same way, down to single shells.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 178.858,
  "end": 190.204,
  "text": "On jumbled rows of 65,536, that took about 965,755 comparisons on average.",
  "syllables": 43,
  "seconds": 11.346,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 2,
  "start": 191.071,
  "end": 194.765,
  "text": "Insertion took more than a thousand times as many.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 198.018,
  "end": 200.129,
  "text": "Double the row and see what happens.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 200.996,
  "end": 202.843,
  "text": "Knocking along it doubles.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 2,
  "start": 203.711,
  "end": 205.03,
  "text": "Halving adds one knock.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 3,
  "start": 205.897,
  "end": 209.591,
  "text": "Insertion sort on a jumbled row about quadruples.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 4,
  "start": 210.459,
  "end": 212.833,
  "text": "Merge sort a little more than doubles.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 214.46,
  "end": 226.861,
  "text": "On this computer, sorting 65,536 jumbled shells took 1,151 milliseconds by insertion and 7.34 by merging.",
  "syllables": 47,
  "seconds": 12.401,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 230.114,
  "end": 233.016,
  "text": "These are counts of comparisons, not times.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 233.883,
  "end": 247.867,
  "text": "A real computer also pays for moving things and for memory, and the built-in sort that comes with the JavaScript engine, which counts nothing, took 2.99 milliseconds on the same row and the same computer.",
  "syllables": 53,
  "seconds": 13.984,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 249.494,
  "end": 254.771,
  "text": "But the counts tell you which way it grows, and that matters more as the row gets longer.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 258.024,
  "end": 262.509,
  "text": "Put the shells in order once, and then halve the beach every time you look.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 264.136,
  "end": 264.663,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
