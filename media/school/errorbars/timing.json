[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.977,
  "end": 6.769,
  "text": "Error bars.",
  "syllables": 3,
  "seconds": 0.792,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 7.823,
  "end": 9.406,
  "text": "How sure is the number.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 11.383,
  "end": 17.188,
  "text": "Every lesson so far has quoted numbers, a loss here, a share of right answers there.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 18.242,
  "end": 20.353,
  "text": "Each came from one set of test rows.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 2,
  "start": 21.408,
  "end": 26.685,
  "text": "Tonight Rerun asks how much those numbers would move if the rows had been different.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 30.639,
  "end": 40.665,
  "text": "Score the attention model on 1,024 held-out rows: a loss of 0.6676 and 73 percent of next words right.",
  "syllables": 38,
  "seconds": 10.026,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 42.642,
  "end": 44.489,
  "text": "Those rows were drawn at random.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 45.544,
  "end": 50.029,
  "text": "Another draw of the same size would give a slightly different loss.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 2,
  "start": 51.083,
  "end": 53.194,
  "text": "The question is how different.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 57.148,
  "end": 62.953,
  "text": "Bradley Efron's answer, in 1979, was the bootstrap.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 64.008,
  "end": 73.242,
  "text": "You cannot draw more rows from the world, so draw from the rows you have: pick as many as you have, at random, allowing repeats, and score that pile.",
  "syllables": 35,
  "seconds": 9.235,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 2,
  "start": 74.297,
  "end": 76.144,
  "text": "Do it thousands of times.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 78.121,
  "end": 79.44,
  "text": "The scores spread out.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 80.494,
  "end": 85.244,
  "text": "We take the middle 95 percent of them as the interval.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 87.221,
  "end": 98.303,
  "text": "With 64 rows the loss is 0.7000, and the interval runs from 0.6723 to 0.7282.",
  "syllables": 42,
  "seconds": 11.082,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "predict": 0,
  "start": 102.257,
  "end": 107.006,
  "text": "Four times as many rows. How much narrower does the interval get?",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 109.506,
  "end": 124.546,
  "text": "Its width is 0.0838 with 16 rows, 0.0559 with 64, 0.0311 with 256 and 0.0161 with 1,024.",
  "syllables": 57,
  "seconds": 15.04,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 126.523,
  "end": 132.591,
  "text": "From 16 to 64 rows it narrows by a third; after that, by nearly half each time.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 133.646,
  "end": 148.421,
  "text": "Averaged over a thousand fresh draws, 0.1014, 0.0523 and 0.0264, each fourfold step halves it, as the square root of the number of rows says it should.",
  "syllables": 56,
  "seconds": 14.776,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 149.476,
  "end": 153.17,
  "text": "Four times the rows buys an interval half as wide.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 157.124,
  "end": 163.192,
  "text": "An interval is only worth something if it catches the truth as often as it claims.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 164.247,
  "end": 166.622,
  "text": "Usually nobody knows the truth.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 2,
  "start": 167.676,
  "end": 176.647,
  "text": "Here we do: the rules that write the guides' sentences give an exact average loss for their own guesses, 0.6361.",
  "syllables": 34,
  "seconds": 8.971,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 178.624,
  "end": 189.97,
  "text": "So draw 1,000 fresh sets of 64 rows from the rules, score the rules' own guesses on each, build an interval, and count how many contain 0.6361.",
  "syllables": 43,
  "seconds": 11.346,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 191.024,
  "end": 193.926,
  "text": "The answer: 93.1 percent.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 2,
  "start": 194.981,
  "end": 198.675,
  "text": "With 256 rows, 95.3.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 3,
  "start": 199.729,
  "end": 204.479,
  "text": "Close to the 95 promised, a little short when rows are few.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 208.433,
  "end": 211.863,
  "text": "One choice matters more than it looks: what counts as one draw.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 212.917,
  "end": 227.693,
  "text": "Evan Miller's 2024 paper on error bars for evaluations warns that questions which come in clusters must be counted as clusters when the error is worked out, or the interval comes out too narrow.",
  "syllables": 56,
  "seconds": 14.776,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 229.67,
  "end": 233.628,
  "text": "Our rows are clusters too, but of a kind that steadies the score.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 234.682,
  "end": 241.806,
  "text": "Each holds one word at every position, so a row is a balanced sample of easy and hard places.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 2,
  "start": 242.861,
  "end": 251.04,
  "text": "Resampling single words instead gives intervals that are too wide here: they caught the truth 100 percent of the time.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 253.017,
  "end": 258.558,
  "text": "Now make real clusters: 1,000 test sets of 16 rows, each row copied four times.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 1,
  "start": 259.612,
  "end": 267.528,
  "text": "Treated as 64 separate rows, the interval catches the truth only 66.9 percent of the time.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 2,
  "start": 268.582,
  "end": 273.595,
  "text": "Resampling the 16 distinct rows brings it back to 93.3.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 277.55,
  "end": 283.354,
  "text": "In the distillation lesson, one student learned from the text and one from the teacher's odds.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 284.409,
  "end": 287.575,
  "text": "Score both on the same 1,024 rows.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 2,
  "start": 288.629,
  "end": 294.434,
  "text": "The student taught by the text has the lower loss, by 0.0045.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 296.411,
  "end": 311.187,
  "text": "Resample the rows once for both models, keeping each row's two scores together, and the interval for the difference runs from -0.0081 to -0.0011: it leaves out zero.",
  "syllables": 56,
  "seconds": 14.776,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 312.241,
  "end": 319.629,
  "text": "Resample each model on its own and the interval is 3.27 times as wide, and it contains zero.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 0,
  "start": 321.606,
  "end": 325.036,
  "text": "Keeping the pairs cancels the rows that are hard for both.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 1,
  "start": 326.091,
  "end": 329.257,
  "text": "Shuffle the pairing and the advantage disappears.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 333.211,
  "end": 337.169,
  "text": "But that difference came from one training run of each student.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 338.223,
  "end": 343.5,
  "text": "Train each with five seeds, the run we just scored and four more, and score them all on the same rows.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 345.477,
  "end": 353.921,
  "text": "For one student, the spread of loss across seeds is about 12 times the spread the bootstrap found from rows; for the other, about 10.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 1,
  "start": 354.975,
  "end": 358.933,
  "text": "Some runs never learned to look back, and those runs make most of it.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 2,
  "start": 359.987,
  "end": 375.818,
  "text": "Seed by seed, the difference between the two students was -0.0045, 0.0845, -0.0049, 0.0007 and 0.0064.",
  "syllables": 60,
  "seconds": 15.831,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 0,
  "start": 377.795,
  "end": 381.225,
  "text": "The first seed's interval was honest about its rows.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 1,
  "start": 382.28,
  "end": 384.655,
  "text": "It said nothing about the next seed.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 388.609,
  "end": 391.775,
  "text": "A number without its spread is half a number.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 1,
  "start": 392.829,
  "end": 397.579,
  "text": "Ask what was drawn at random, the rows, the seeds or both, and draw again from that.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 2,
  "start": 398.633,
  "end": 406.285,
  "text": "Everything tonight came from one small model and a handful of runs; the method carries over, the numbers do not.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 408.262,
  "end": 415.122,
  "text": "Next under the prism: what happens when training pushes a model toward the measure instead of the goal.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 1,
  "start": 416.176,
  "end": 416.704,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
