[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.728,
  "end": 8.367,
  "text": "fp16, bf16 and tensor cores.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 10.095,
  "end": 16.163,
  "text": "Graphics chips multiply much faster in 16-bit numbers than in 32-bit ones.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 17.085,
  "end": 25.528,
  "text": "Tonight Tallow measures what a 16-bit number can hold, where it goes wrong, and why the sums are often kept in 32 bits.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 28.984,
  "end": 32.414,
  "text": "Think of a number format as a measuring jug.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 33.336,
  "end": 36.502,
  "text": "The marks are its precision; the height is its range.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 38.23,
  "end": 51.159,
  "text": "fp16 has 11 bits of significand and tops out at 65,504. bf16 keeps the range of 32-bit numbers but has only 8 bits of significand.",
  "syllables": 49,
  "seconds": 12.929,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 52.081,
  "end": 54.719,
  "text": "32-bit numbers have 24.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 58.175,
  "end": 60.55,
  "text": "Look at the marks near 110.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "predict": 0,
  "start": 61.472,
  "end": 65.429,
  "text": "fp16 near 110. How far apart are the marks?",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 67.929,
  "end": 72.415,
  "text": "In fp16 they are 0.0625 apart.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 2,
  "start": 73.337,
  "end": 75.447,
  "text": "In bf16, 0.5.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 3,
  "start": 76.369,
  "end": 80.327,
  "text": "Any number in between is rounded to the nearest mark.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 82.055,
  "end": 90.498,
  "text": "So in fp16 a number near 110 can be off by up to one thirty-second, about 0.03.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 91.42,
  "end": 94.058,
  "text": "That is about three parts in ten thousand.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 2,
  "start": 94.98,
  "end": 102.104,
  "text": "A job that needs one part in ten thousand needs a significand of 13 bits; fp16 has 11.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 3,
  "start": 103.026,
  "end": 105.4,
  "text": "We will need that in the next lesson.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 108.856,
  "end": 114.925,
  "text": "Now add 1 to a running total, five thousand times, keeping the total in fp16.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 116.653,
  "end": 119.028,
  "text": "It stops at 2,048.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 119.949,
  "end": 124.171,
  "text": "There the marks are 2 apart, and adding 1 rounds back to where it was.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 125.093,
  "end": 128.523,
  "text": "In bf16 it stops at 256.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 131.979,
  "end": 142.533,
  "text": "This is why tensor cores, the units that multiply small tables of numbers in one step, can take 16-bit inputs and keep the running sums in 32 bits.",
  "syllables": 40,
  "seconds": 10.554,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 143.454,
  "end": 147.676,
  "text": "With fp16 inputs they can also sum in fp16.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 2,
  "start": 148.598,
  "end": 152.819,
  "text": "With bf16 inputs, the sums are always 32-bit.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 154.547,
  "end": 164.31,
  "text": "Paulius Micikevicius and colleagues trained large networks this way in 2018 and kept a 32-bit master copy of the weights.",
  "syllables": 37,
  "seconds": 9.763,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 166.038,
  "end": 178.175,
  "text": "On the second floor's feed-forward table of our model, the error with fp16 inputs and 32-bit sums is about 0.0003 of the answer's size.",
  "syllables": 46,
  "seconds": 12.137,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 1,
  "start": 179.097,
  "end": 184.638,
  "text": "Keep the sums in fp16 too, and it grows to about 0.001.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 188.094,
  "end": 196.537,
  "text": "Run the whole model with every stored number rounded to 16 bits and score it on 1,024 held-out rows.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 198.265,
  "end": 200.112,
  "text": "The loss barely moves.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 201.034,
  "end": 211.588,
  "text": "It stays at 0.6676 with fp16 inputs and 32-bit sums, and rises to 0.6679 with bf16 throughout.",
  "syllables": 40,
  "seconds": 10.554,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 2,
  "start": 212.51,
  "end": 217.787,
  "text": "Its numbers stay far below fp16's limit, so nothing overflows.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 3,
  "start": 218.708,
  "end": 223.194,
  "text": "Its sums are short, at most 64 terms, so the rounding hardly shows.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 224.922,
  "end": 229.935,
  "text": "We only ran this model in 16 bits; we did not train it that way.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 1,
  "start": 230.857,
  "end": 235.078,
  "text": "When large models are trained in 16 bits, the rounding can show.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 2,
  "start": 236.0,
  "end": 240.222,
  "text": "Micikevicius and colleagues needed three fixes to stop it.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 243.678,
  "end": 249.482,
  "text": "Small inputs, big sums: the marks you can afford for the parts, and the marks you need for the total.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 251.21,
  "end": 256.751,
  "text": "Next, at the prism: one glint of light that 16 bits could not hold precisely enough.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 257.673,
  "end": 258.201,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
