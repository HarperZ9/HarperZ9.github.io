[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.518,
  "end": 6.046,
  "text": "Tokens.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 6.856,
  "end": 8.703,
  "text": "Cutting text into crates.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 10.221,
  "end": 15.234,
  "text": "Everything that comes through my customs shed goes into a standard crate.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 16.044,
  "end": 19.474,
  "text": "Text too, before any language model can touch it.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 22.51,
  "end": 25.149,
  "text": "A language model doesn't read letters.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 25.958,
  "end": 30.972,
  "text": "It reads a list of pieces, each one a number from its vocabulary.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 2,
  "start": 31.781,
  "end": 34.684,
  "text": "The question is how big to cut the pieces.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 36.202,
  "end": 49.922,
  "text": "Cut by letter, with one extra mark for the end of each word, and the guides' sentences take about 4.39 pieces per word, counting each full stop and question mark as a word: tiny crates, a great many trips.",
  "syllables": 52,
  "seconds": 13.72,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 51.44,
  "end": 54.607,
  "text": "Cut by whole word, and every word is one piece.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 55.416,
  "end": 59.374,
  "text": "But a word the model has never seen has no crate at all.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 62.41,
  "end": 65.049,
  "text": "Byte-pair encoding meets in the middle.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 65.859,
  "end": 67.442,
  "text": "Start from single letters.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 2,
  "start": 68.252,
  "end": 71.945,
  "text": "Count every pair of neighbouring pieces, inside words.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 3,
  "start": 72.755,
  "end": 75.658,
  "text": "The most common pair gets a crate of its own.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 4,
  "start": 76.467,
  "end": 77.523,
  "text": "Then count again.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 79.041,
  "end": 86.693,
  "text": "On the guides' sentences, the first merge joins an e to the end-of-word mark, so an e that ends a word gets one crate.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 87.502,
  "end": 90.932,
  "text": "By the fifth merge, the whole word 'the' has its own crate.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "predict": 0,
  "start": 92.451,
  "end": 96.408,
  "text": "After fifty merges, how many pieces does a word take?",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 98.908,
  "end": 104.449,
  "text": "After 50 merges, a word takes 1.80 pieces on average.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 1,
  "start": 105.259,
  "end": 111.064,
  "text": "After 136, every one of the guides' words is a single piece.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 114.1,
  "end": 117.266,
  "text": "Now a word that never came through the shed: lamplit.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 118.076,
  "end": 119.659,
  "text": "There's no crate for it.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 121.177,
  "end": 127.246,
  "text": "So it's cut into pieces that do have crates: l, am, p, and lit at the end of a word.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 128.056,
  "end": 129.903,
  "text": "Nothing is thrown away.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 130.712,
  "end": 137.836,
  "text": "Rico Sennrich and his colleagues used this method, in a 2016 paper, to translate rare words.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 140.873,
  "end": 144.039,
  "text": "The guides only know 44 words and 2 marks.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 144.849,
  "end": 153.292,
  "text": "So here's real English: the opening of Moby-Dick, about 599 words of it, to learn the merges from.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 154.81,
  "end": 159.032,
  "text": "Then a page it never saw, the opening of Pride and Prejudice.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 159.841,
  "end": 164.855,
  "text": "With 400 merges, the new page takes 2.14 pieces per word.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 2,
  "start": 165.664,
  "end": 169.622,
  "text": "The word lighthouse, never seen, comes out as li, gh, thou and se.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 172.659,
  "end": 174.769,
  "text": "Does it matter which pairs we merge?",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 175.579,
  "end": 186.133,
  "text": "Merge random pairs instead, the same number of times, and over ten tries the guides' words still take 1.32 to 1.67 pieces each, instead of one.",
  "syllables": 40,
  "seconds": 10.554,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 189.17,
  "end": 192.6,
  "text": "There's one more choice: what the very first pieces are.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 193.409,
  "end": 194.992,
  "text": "Characters run out fast.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 2,
  "start": 195.802,
  "end": 206.62,
  "text": "The page from Pride and Prejudice has curly quotation marks, and a capital D and E, that Moby-Dick never used, so with characters as the base, they have no crate.",
  "syllables": 41,
  "seconds": 10.818,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 208.138,
  "end": 210.249,
  "text": "GPT-2 starts from bytes instead.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 211.059,
  "end": 217.127,
  "text": "There are only 256 of them, and any text at all is some list of bytes.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 2,
  "start": 217.937,
  "end": 225.325,
  "text": "An a is one byte, an e with its accent built in is two, a curly apostrophe three, and a seal emoji four.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 0,
  "start": 226.843,
  "end": 232.384,
  "text": "Start from bytes, and that new page has 0 pieces without a crate, instead of 16.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 235.42,
  "end": 240.17,
  "text": "The little language model from the attention lesson skips all of this.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 240.979,
  "end": 248.895,
  "text": "It has one crate per word, 46 of them counting the full stop and question mark, because its whole world is those 46.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 250.413,
  "end": 265.981,
  "text": "Byte-pair encoding needs 136 merges, and a vocabulary of 160, to cut the same sentences into whole words, because every piece it made on the way stays in the vocabulary.",
  "syllables": 59,
  "seconds": 15.567,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 269.017,
  "end": 276.669,
  "text": "Common pairs get their own crates, rare words come apart into pieces, and bytes mean nothing is ever left on the dock.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 278.187,
  "end": 281.353,
  "text": "Next: giving every crate a place on the chart.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 1,
  "start": 282.163,
  "end": 282.69,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
