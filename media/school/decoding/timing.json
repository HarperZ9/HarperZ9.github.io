[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.56,
  "end": 6.351,
  "text": "Decoding.",
  "syllables": 3,
  "seconds": 0.792,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 7.183,
  "end": 9.558,
  "text": "Turning guesses into sentences.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 11.117,
  "end": 17.977,
  "text": "In the lesson on next-word prediction, the model's guess was a spread of belief over every word.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 18.809,
  "end": 21.184,
  "text": "A sentence needs one word at a time.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 2,
  "start": 22.016,
  "end": 26.237,
  "text": "Tonight, how the choosing is done, and what each way of choosing does.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 29.357,
  "end": 32.787,
  "text": "The simplest way: always take the widest slot.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 33.619,
  "end": 35.993,
  "text": "That is called greedy decoding.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 37.553,
  "end": 40.191,
  "text": "Start the model on pylon and let it run.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 41.023,
  "end": 43.398,
  "text": "It writes: pylon found a kettle.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 2,
  "start": 44.23,
  "end": 46.604,
  "text": "Pylon put a cone on the kettle.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 3,
  "start": 47.436,
  "end": 49.019,
  "text": "Pylon found a kettle.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 4,
  "start": 49.851,
  "end": 52.226,
  "text": "And again, until the page runs out.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 53.785,
  "end": 55.896,
  "text": "Why the kettle every time?",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 56.728,
  "end": 64.644,
  "text": "After found a, the rules choose among 10 things equally, but the model leans a little: kettle gets 14 percent.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 2,
  "start": 65.475,
  "end": 70.489,
  "text": "A small lean, taken every time, becomes the only story it tells.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 73.608,
  "end": 80.204,
  "text": "The other way: spin a wheel where each word's slot is as wide as its share, and take whatever comes up.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 81.764,
  "end": 85.722,
  "text": "We spun it 1,500 times from the same start.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 86.553,
  "end": 95.26,
  "text": "Those runs wrote 1,482 different texts, and 89 percent of the runs could have been written by the rules.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 96.82,
  "end": 98.403,
  "text": "Our check for that is strict.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 1,
  "start": 99.235,
  "end": 110.053,
  "text": "It parses each run with the rules themselves, including the long-range ones: the cone goes on the thing that was found, and the answer to who names the guide who did it.",
  "syllables": 41,
  "seconds": 10.818,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 113.172,
  "end": 119.769,
  "text": "Before the wheel is cut, the scores can be divided by a number called the temperature.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 120.6,
  "end": 124.294,
  "text": "Below 1, the wide slots get wider and the thin ones shrink.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 2,
  "start": 125.126,
  "end": 128.029,
  "text": "Above 1, the shares move toward even.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 129.588,
  "end": 142.781,
  "text": "After tallow found a, the kettle's slot is 20 percent of the wheel at temperature 0.5, and 11 percent at temperature 2, where words that make no sense there get bigger slots too.",
  "syllables": 50,
  "seconds": 13.193,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "predict": 0,
  "start": 144.34,
  "end": 149.617,
  "text": "Turn the temperature up to 2. What share of runs will still follow the rules?",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 152.117,
  "end": 157.922,
  "text": "At temperature 0.5, 98 percent of runs follow the rules.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 1,
  "start": 158.754,
  "end": 160.073,
  "text": "At 1, 89.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 2,
  "start": 160.905,
  "end": 162.752,
  "text": "At 1.5, 51.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 3,
  "start": 163.584,
  "end": 165.431,
  "text": "At 2, only 11.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 3,
  "sentence": 0,
  "start": 166.99,
  "end": 172.267,
  "text": "And at temperature close to zero, the widest slot takes the whole wheel.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 3,
  "sentence": 1,
  "start": 173.099,
  "end": 178.64,
  "text": "In 200 spins at 0.01, every run was the greedy one.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 181.759,
  "end": 186.509,
  "text": "Another fix cuts the wheel down to the k widest slots before spinning.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 187.341,
  "end": 192.09,
  "text": "Fan and colleagues used ten for writing stories in 2018.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 193.65,
  "end": 198.663,
  "text": "With k at 3, after tallow found a, the wheel keeps 3 slots: kettle, map and crate.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 199.495,
  "end": 203.716,
  "text": "The other things that could be found are never written there at all.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 205.276,
  "end": 207.651,
  "text": "The catch is that k never changes.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 1,
  "start": 208.482,
  "end": 212.176,
  "text": "Where only two words make sense, three slots is one too many.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 2,
  "start": 213.008,
  "end": 215.119,
  "text": "Where ten make sense, three is too few.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 218.238,
  "end": 227.473,
  "text": "Holtzman and colleagues, in 2020, cut the wheel by share instead: keep the widest slots until together they reach p, and drop the rest.",
  "syllables": 35,
  "seconds": 9.235,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 228.305,
  "end": 231.471,
  "text": "Where the model is sure, that is one or two words.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 2,
  "start": 232.303,
  "end": 234.414,
  "text": "Where it is torn, it is many.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 235.973,
  "end": 240.723,
  "text": "With p at 0.9, after tallow found a, the wheel keeps 9 slots.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 241.554,
  "end": 244.985,
  "text": "Runs that follow the rules: 94 percent.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 246.544,
  "end": 253.932,
  "text": "Push p down to 0.5 and nearly every run follows the rules, 99.7 percent.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "predict": 0,
  "start": 254.764,
  "end": 259.249,
  "text": "Nearly every run follows the rules. What has it given up?",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 1,
  "start": 261.749,
  "end": 267.026,
  "text": "But its 1,500 runs wrote only 210 different texts.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 2,
  "start": 267.858,
  "end": 268.914,
  "text": "Safe, and samey.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 272.033,
  "end": 278.629,
  "text": "That paper also found that plain spinning, at temperature 1, drifts into nonsense in big models.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 279.461,
  "end": 286.849,
  "text": "Thousands of unlikely words each get a sliver of the wheel, and together the slivers add up to far too much.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 288.408,
  "end": 289.992,
  "text": "Ours shows a small version.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 290.823,
  "end": 296.892,
  "text": "At temperature 1, 4 percent of runs contain a word pair it never saw in training.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 2,
  "start": 297.724,
  "end": 305.112,
  "text": "Top-p at 0.9 lets none through, and rule-following rises from 89 to 94 percent.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 0,
  "start": 306.671,
  "end": 318.017,
  "text": "The paper's other warning sign does not show here: scoring its own runs, the model is torn between 1.87 words per step, and scoring the rules' own runs, 1.92.",
  "syllables": 43,
  "seconds": 11.346,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 1,
  "start": 318.849,
  "end": 321.751,
  "text": "With only 46 words, the tail is short.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 2,
  "start": 322.583,
  "end": 325.749,
  "text": "The full problem needs a bigger model to see.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 328.868,
  "end": 331.243,
  "text": "Greedy tells one story forever.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 332.075,
  "end": 333.394,
  "text": "Spinning tells many.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 2,
  "start": 334.226,
  "end": 339.503,
  "text": "Temperature, top-k and top-p decide how wide the wheel's slots are before it spins.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 341.063,
  "end": 346.076,
  "text": "Next in the lighthouse: how to tell whether a language model is any good.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 1,
  "start": 346.908,
  "end": 347.435,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
