[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.585,
  "end": 6.64,
  "text": "Optimisers.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 7.486,
  "end": 9.069,
  "text": "Better ways to step.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 10.654,
  "end": 14.612,
  "text": "Last time I walked downhill one careful step at a time.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 15.457,
  "end": 18.623,
  "text": "Tonight the walker gets weight, and then a pair of shoes.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 21.794,
  "end": 24.432,
  "text": "Remember the long, narrow valley.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 25.278,
  "end": 27.388,
  "text": "Steep across, nearly flat along.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 28.973,
  "end": 34.778,
  "text": "Careful steps have to stay small for the steep way, so along the floor they crawl.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 35.624,
  "end": 44.067,
  "text": "At the best step we tried, it takes 6,217 steps to get the loss under a ten-thousandth and keep it there.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 47.237,
  "end": 49.084,
  "text": "Now make the walker heavy.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 49.929,
  "end": 55.206,
  "text": "Each step keeps 90 percent of the last step's motion and adds the new slope on top.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 56.792,
  "end": 61.277,
  "text": "Across the valley, the slopes keep flipping, so they cancel.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 62.122,
  "end": 66.608,
  "text": "Along the floor they all point the same way, so they add up.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 2,
  "start": 67.453,
  "end": 71.147,
  "text": "The walker picks up speed exactly where it was crawling.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 72.732,
  "end": 77.745,
  "text": "Boris Polyak described it in 1964.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 1,
  "start": 78.591,
  "end": 81.229,
  "text": "It's known as the heavy ball method.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 84.4,
  "end": 87.83,
  "text": "The other idea is shoes that adjust to the ground.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 88.675,
  "end": 94.744,
  "text": "Adam keeps a running average of each slope, and a running average of each slope squared.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 96.329,
  "end": 100.023,
  "text": "It divides the first by the square root of the second.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 100.868,
  "end": 111.95,
  "text": "So a direction with a steady slope gets a step of about the same size, however steep or gentle it is: steep directions are slowed down, gentle ones sped up.",
  "syllables": 42,
  "seconds": 11.082,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 112.795,
  "end": 116.225,
  "text": "A direction whose slope keeps flipping gets a short step.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 117.81,
  "end": 122.296,
  "text": "Both averages start at zero, so at first they're too small.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 1,
  "start": 123.141,
  "end": 133.168,
  "text": "Adam scales them back up, so its very first step is the step size you chose, to within a hair, in every direction that has any slope at all.",
  "syllables": 38,
  "seconds": 10.026,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 136.338,
  "end": 137.921,
  "text": "Same valley, same start.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "predict": 0,
  "start": 138.766,
  "end": 141.405,
  "text": "Which walker gets down this valley first?",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 143.905,
  "end": 147.071,
  "text": "Each walker gets the best step from a few we tried.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 148.656,
  "end": 152.614,
  "text": "The heavy ball, by a mile: 285 steps.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 153.459,
  "end": 157.153,
  "text": "Careful steps take 6,217.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 2,
  "start": 157.999,
  "end": 169.608,
  "text": "Adam dips under the line at step 10,346, keeps wandering around it, and only stays under after 16,790.",
  "syllables": 44,
  "seconds": 11.609,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 171.193,
  "end": 179.373,
  "text": "And on the gentle bowl from last time, careful steps win: 33 steps, against 146 for the other two.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 1,
  "start": 180.218,
  "end": 182.857,
  "text": "No walker is best on every hill.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 186.027,
  "end": 191.831,
  "text": "Remember the edge on the bowl: past a step of 0.5, careful steps fly off.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 192.677,
  "end": 193.996,
  "text": "Try 0.6.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 195.581,
  "end": 197.956,
  "text": "Careful steps fly off, as before.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 198.801,
  "end": 203.023,
  "text": "The heavy ball's edge here is 0.95, so it gets down.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 2,
  "start": 203.868,
  "end": 209.145,
  "text": "Adam's steps don't grow with the slope, so it doesn't fly off, and here it gets down too.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 212.316,
  "end": 215.218,
  "text": "The step size doesn't have to stay fixed.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 216.063,
  "end": 224.77,
  "text": "Many models start with a warmup, small steps while everything is new, then let the step size fall away along a smooth curve.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 226.355,
  "end": 234.799,
  "text": "And AdamW adds one more thing: almost every number shrinks by a small fraction at each step, kept separate from Adam's own step.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 235.644,
  "end": 239.866,
  "text": "It pulls numbers that aren't earning their keep back towards zero.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 243.036,
  "end": 259.131,
  "text": "On the spirals from the bucket chain, with each walker's step chosen on a separate set of points, careful steps first pass 95 percent on new points at step 2,000, the heavy ball at 1,300, and Adam at 900.",
  "syllables": 61,
  "seconds": 16.095,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 260.716,
  "end": 276.283,
  "text": "But run five different starting networks and batch orders, and Adam's final score ranges from 91.8 to 99.3 percent, while careful steps stay between 99.0 and 99.8.",
  "syllables": 59,
  "seconds": 15.567,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 1,
  "start": 277.129,
  "end": 279.24,
  "text": "Fast, and on this network, less steady.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 0,
  "start": 280.825,
  "end": 285.046,
  "text": "The language model from the attention lesson trains with AdamW.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 1,
  "start": 285.892,
  "end": 298.557,
  "text": "For its first 400 steps, with the same start and the same sentences, AdamW reaches a held-out loss of 0.85, the heavy ball 0.89, and careful steps 0.96.",
  "syllables": 48,
  "seconds": 12.665,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 301.727,
  "end": 308.059,
  "text": "Every number tonight depends on the hill and on the handful of steps we tried for each walker.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 1,
  "start": 308.905,
  "end": 312.335,
  "text": "Try more, or a different hill, and the order can change.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 313.92,
  "end": 318.405,
  "text": "And four hundred steps is the first fifth of the language model's training.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 1,
  "start": 319.251,
  "end": 326.111,
  "text": "It has barely started to copy, so this shows who gets off the line fastest, not who finishes best.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 0,
  "start": 329.281,
  "end": 331.392,
  "text": "Weight carries you through the zigzags.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 1,
  "start": 332.237,
  "end": 335.139,
  "text": "Shoes give every direction its own stride.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 2,
  "start": 335.985,
  "end": 337.832,
  "text": "Neither wins every hill.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 1,
  "sentence": 0,
  "start": 339.417,
  "end": 343.902,
  "text": "Next along the hill: learning a harbour by heart, and why that's a trap.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 1,
  "sentence": 1,
  "start": 344.748,
  "end": 345.276,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
