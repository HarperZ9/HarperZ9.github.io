[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.589,
  "end": 6.909,
  "text": "The transformer block.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 7.756,
  "end": 8.812,
  "text": "Two floors, one stream.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 10.401,
  "end": 13.568,
  "text": "Every word's list of numbers climbs the tower.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 14.415,
  "end": 17.845,
  "text": "On each floor, two rooms read it and add something to it.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 2,
  "start": 18.693,
  "end": 21.332,
  "text": "Tonight, what those rooms are, and what each one adds.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 24.511,
  "end": 35.856,
  "text": "Start with a word's 32 numbers from the word table, its embedding, and add to them, number by number, 32 more from a second table for its place in the sentence.",
  "syllables": 43,
  "seconds": 11.346,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 36.704,
  "end": 37.759,
  "text": "Call that the stream.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 39.349,
  "end": 43.57,
  "text": "Each room reads the stream, works out something, and adds its answer back on.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 44.418,
  "end": 46.265,
  "text": "Nothing is thrown away.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 2,
  "start": 47.113,
  "end": 50.543,
  "text": "That adding is called the residual connection.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 52.132,
  "end": 57.937,
  "text": "Before each room reads, it takes a copy of the stream rescaled to a steady size.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 58.785,
  "end": 64.326,
  "text": "That is layer norm, and in this model, as in GPT-2, it comes first in each room.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 2,
  "start": 65.174,
  "end": 67.284,
  "text": "The stream itself is left alone.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 70.463,
  "end": 76.268,
  "text": "The first room is attention: each word looks back along the sentence and takes in what it needs.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 77.116,
  "end": 81.601,
  "text": "This model has 2 heads per floor, two separate ways of looking.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 83.191,
  "end": 90.315,
  "text": "The second room is a small network that works on each word alone, called the MLP or feed-forward layer.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 91.162,
  "end": 96.176,
  "text": "It widens the 32 numbers to 64, bends them, and narrows them back.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 97.765,
  "end": 109.902,
  "text": "Attention and the MLP hold almost the same number of the model's 20,864 numbers: 8,448 and 8,384.",
  "syllables": 46,
  "seconds": 12.137,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 113.081,
  "end": 123.635,
  "text": "We can stop the stream on any landing and ask it to guess the next word early, using the model's own last two steps: its final layer norm and its output table.",
  "syllables": 40,
  "seconds": 10.554,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "predict": 0,
  "start": 125.225,
  "end": 129.183,
  "text": "Which floor will matter most for copying a word from far back?",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 131.683,
  "end": 136.168,
  "text": "Straight from the table, the guess has a held-out loss of 2.33.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 137.016,
  "end": 139.654,
  "text": "After the first floor, 0.86.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 140.502,
  "end": 143.141,
  "text": "After the second, 0.69.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 144.73,
  "end": 153.965,
  "text": "Copying a word from far back is the slow part: right 43 percent of the time after the first floor, and 99 percent at the top.",
  "syllables": 35,
  "seconds": 9.235,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 157.144,
  "end": 160.838,
  "text": "Now switch rooms off, one at a time, and score the model again.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 161.686,
  "end": 166.699,
  "text": "With everything on, it copies right 99 percent of the time.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 168.288,
  "end": 173.301,
  "text": "Silence the second head on the top floor, and copying falls to 40 percent.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 174.149,
  "end": 178.371,
  "text": "Silence the first head there, and nothing changes: 99 percent.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 2,
  "start": 179.218,
  "end": 184.759,
  "text": "On the top floor, one head does most of the copying, and its neighbour is close to idle.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 3,
  "start": 185.607,
  "end": 191.94,
  "text": "Copying needs a head on the first floor too: silence it, and copying falls to 38 percent.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 193.529,
  "end": 200.125,
  "text": "Switch off the first floor's MLP, and the loss jumps from 0.69 to 5.96, worse than a blind guess.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 3,
  "sentence": 0,
  "start": 201.715,
  "end": 206.2,
  "text": "On an untrained model, the same switches barely move the loss.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 3,
  "sentence": 1,
  "start": 207.048,
  "end": 209.159,
  "text": "The jobs were learned, not built in.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 212.338,
  "end": 217.615,
  "text": "What if a room replaced the stream with its answer, instead of adding to it?",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "predict": 0,
  "start": 219.204,
  "end": 224.745,
  "text": "If a room replaces the stream instead of adding to it, what happens to the loss?",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 227.245,
  "end": 231.203,
  "text": "For the top floor's attention, the loss goes to 6.62.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 232.051,
  "end": 237.592,
  "text": "The room was only ever adding a little, and the rest of the stream was still needed.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 239.181,
  "end": 241.028,
  "text": "One room is the odd one out.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 1,
  "start": 241.876,
  "end": 251.111,
  "text": "The first floor's MLP adds a vector about 10 times the size of the stream it reads, so replacing barely matters there: 0.69.",
  "syllables": 35,
  "seconds": 9.235,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 254.29,
  "end": 262.205,
  "text": "A block is two rooms on one stream: attention looks along the sentence, the MLP works on each word, and each adds its answer back on.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 263.795,
  "end": 267.489,
  "text": "Next in the lighthouse: how the whole tower is trained.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 268.336,
  "end": 268.864,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
