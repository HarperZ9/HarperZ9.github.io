[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.868,
  "end": 6.923,
  "text": "Matmul tiling.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 8.791,
  "end": 14.859,
  "text": "Most of the arithmetic in a language model is multiplying tables of numbers.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 15.856,
  "end": 23.507,
  "text": "Tonight Pylon shows a classic trick for doing that fast on a graphics chip: carry a tray, not one can at a time.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 27.243,
  "end": 37.533,
  "text": "Multiplying two square tables, each number of the answer is a row of the first table times a column of the second: multiply pairs, add them up.",
  "syllables": 39,
  "seconds": 10.29,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 39.401,
  "end": 49.427,
  "text": "For tables 1,024 wide, one answer number needs 2,048 reads from the warehouse, 1,024 from each table.",
  "syllables": 38,
  "seconds": 10.026,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 53.163,
  "end": 59.231,
  "text": "The simple kernel gives each thread one answer number and lets it fetch everything itself.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 60.227,
  "end": 68.143,
  "text": "Every number of each table is then fetched 1,024 times, once for every thread that needs it.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 70.011,
  "end": 80.828,
  "text": "In all, 2,147,483,648 reads from the warehouse, for one multiplication.",
  "syllables": 41,
  "seconds": 10.818,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 84.564,
  "end": 87.73,
  "text": "Now give a crew of threads a square of the answer.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 88.726,
  "end": 99.017,
  "text": "Together they carry a square tile of each table to their bench, the chip's small fast shared memory, and wait until every thread has put its part down.",
  "syllables": 39,
  "seconds": 10.29,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 100.884,
  "end": 103.787,
  "text": "Then each thread works through the tile on the bench.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "predict": 0,
  "start": 104.783,
  "end": 109.532,
  "text": "Tiles 16 wide. How many times fewer reads from the warehouse?",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 112.032,
  "end": 116.518,
  "text": "When every thread is done, the crew fetches the next pair of tiles.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 117.514,
  "end": 124.374,
  "text": "With tiles 16 wide, each number is fetched 64 times instead of 1,024.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 128.109,
  "end": 152.911,
  "text": "Reads from the warehouse: 2,147,483,648 for the simple kernel; 268,435,456 with tiles of 8; 134,217,728 with tiles of 16.",
  "syllables": 94,
  "seconds": 24.802,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 153.908,
  "end": 156.81,
  "text": "The wider the tile, the fewer the trips.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 158.678,
  "end": 162.635,
  "text": "Another way to say it: work done per byte fetched.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 163.632,
  "end": 170.756,
  "text": "The simple kernel does 0.25 operations per byte, counting each multiply and each add as one.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 2,
  "start": 171.752,
  "end": 174.654,
  "text": "Tiles of 16 do 3.97.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 3,
  "start": 175.65,
  "end": 183.83,
  "text": "Vasily Volkov and James Demmel used this counting in 2008 when they tuned matrix code for graphics chips.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 187.565,
  "end": 188.884,
  "text": "The waiting matters.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 189.88,
  "end": 197.268,
  "text": "If a thread starts working before the crew has put the whole tile down, it can read a can from the last tile.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 199.136,
  "end": 202.038,
  "text": "We broke the kernel that way on purpose.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 203.034,
  "end": 218.602,
  "text": "In our emulator, under the worst timing the missing wait allows, its answers came out wrong at every size we tried, and the checker, which compares each number with a careful answer computed on the main processor, caught it.",
  "syllables": 59,
  "seconds": 15.567,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 222.337,
  "end": 225.24,
  "text": "These are counts of reads asked for, not times.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 226.236,
  "end": 233.887,
  "text": "Real chips have caches that can serve repeated reads, so the simple kernel may not be as slow as its count says.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 2,
  "start": 234.884,
  "end": 237.258,
  "text": "How much it gains depends on the chip.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 239.126,
  "end": 245.458,
  "text": "The lab runs both kernels on your own chip, if your browser allows it, and times them beside the count.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 249.194,
  "end": 252.36,
  "text": "Carry a tray once, use it many times.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 253.356,
  "end": 257.314,
  "text": "Fast matrix code on graphics chips is built on the same idea.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 259.182,
  "end": 263.139,
  "text": "Next in the cannery: attention itself, done in one trip.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 1,
  "start": 264.136,
  "end": 264.663,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
