[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.571,
  "end": 6.363,
  "text": "Embeddings.",
  "syllables": 3,
  "seconds": 0.792,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 7.201,
  "end": 9.576,
  "text": "Every word gets coordinates.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 11.147,
  "end": 16.424,
  "text": "Pylon showed you that a word in a model is a list of numbers, a place.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 17.262,
  "end": 19.373,
  "text": "Tonight, where those places come from.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 22.516,
  "end": 27.529,
  "text": "At the start, every word gets a list of 32 small random numbers.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 28.367,
  "end": 30.214,
  "text": "The places mean nothing yet.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 31.786,
  "end": 39.701,
  "text": "Check the neighbours: only 26 percent of words sit next to a word of the same kind, about what a shuffle gives.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 42.844,
  "end": 44.691,
  "text": "The trick is a guessing game.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 45.529,
  "end": 48.695,
  "text": "Take a word in a sentence, and the words around it.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 50.267,
  "end": 56.599,
  "text": "Each word gets two lists: one for when it's the word in the middle, one for when it's a neighbour.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 57.437,
  "end": 66.144,
  "text": "Nudge the lists so that the middle word's list and each real neighbour's neighbour-list get a bigger dot product, the measure from the vectors lesson.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 67.716,
  "end": 75.895,
  "text": "And for every real neighbour, pick 5 words at random, common words more often than rare ones, and push those the other way.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 1,
  "start": 76.733,
  "end": 82.802,
  "text": "Tomas Mikolov and his colleagues called it negative sampling, in 2013.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 85.945,
  "end": 91.222,
  "text": "Run the game over the guides' sentences, 5 times through, and watch the places move.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "predict": 0,
  "start": 92.793,
  "end": 97.015,
  "text": "Will the neighbours keep getting tidier all the way through training?",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 99.515,
  "end": 110.333,
  "text": "Very early, by 5 percent of the way, the neighbours look their tidiest of any checkpoint: 72 percent of words sit next to a word of the same kind.",
  "syllables": 41,
  "seconds": 10.818,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 111.171,
  "end": 123.044,
  "text": "By the end, in this run, it has slipped back to 65, three words fewer out of 46, while the guessing game keeps getting better on sentences it never trained on.",
  "syllables": 45,
  "seconds": 11.873,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 124.616,
  "end": 128.573,
  "text": "Better at the game is not always tidier on the chart.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 1,
  "start": 129.411,
  "end": 133.105,
  "text": "The game is the goal; the neat neighbours are a side effect.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 136.248,
  "end": 149.968,
  "text": "Start from different random numbers, four more times, and you get different coordinates, but much the same neighbours: against the first run, 75 to 80 percent of each word's three nearest neighbours agree.",
  "syllables": 52,
  "seconds": 13.72,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 153.111,
  "end": 164.457,
  "text": "The language model from the attention lesson learned its word lists a different way: as a side effect of guessing the next word, through two layers of attention.",
  "syllables": 43,
  "seconds": 11.346,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 166.028,
  "end": 170.514,
  "text": "Its lists put 80 percent of words next to a word of the same kind.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 171.352,
  "end": 177.684,
  "text": "And between the two tables, about 33 percent of each word's three nearest neighbours agree.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 2,
  "start": 178.522,
  "end": 181.425,
  "text": "By chance it would be about 7 percent.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 182.996,
  "end": 190.384,
  "text": "So the two methods agree on far more than chance, and far less than two runs of the same method agree with each other.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 1,
  "start": 191.222,
  "end": 193.069,
  "text": "Neither one is the true map.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 2,
  "start": 193.907,
  "end": 196.81,
  "text": "Each is a map of what its own game needed.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 199.952,
  "end": 201.536,
  "text": "Nobody draws the chart.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 202.374,
  "end": 206.595,
  "text": "A guessing game moves the cards, and words used alike end up close.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 208.167,
  "end": 211.597,
  "text": "Next in the lighthouse: guessing the next word, and keeping score.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 212.435,
  "end": 212.963,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
