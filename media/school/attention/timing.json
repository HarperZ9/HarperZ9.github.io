[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.246,
  "end": 6.038,
  "text": "Attention.",
  "syllables": 3,
  "seconds": 0.792,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 6.703,
  "end": 9.869,
  "text": "How a language model decides what matters.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 11.116,
  "end": 12.963,
  "text": "I keep the lamp at Night School.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 13.627,
  "end": 15.738,
  "text": "Tonight the lamp is the lesson.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 18.231,
  "end": 21.397,
  "text": "Here is a sentence with a hole at the end.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 22.644,
  "end": 24.227,
  "text": "Rerun found a kettle.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 24.892,
  "end": 26.739,
  "text": "Pylon put a cone on the...",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "predict": 0,
  "start": 27.985,
  "end": 29.832,
  "text": "What word goes in the hole?",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 32.332,
  "end": 33.388,
  "text": "You said kettle.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 34.052,
  "end": 36.691,
  "text": "And you did not read the sentence again.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 2,
  "start": 37.356,
  "end": 41.577,
  "text": "You glanced back, past the full stop, to one word near the start, and took it.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 44.07,
  "end": 46.973,
  "text": "A language model like this one does one job.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 47.637,
  "end": 50.54,
  "text": "It reads the words so far and guesses the next one.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 51.786,
  "end": 59.702,
  "text": "The first neural translation models squeezed the whole sentence into one fixed-length list of numbers, and worked from that.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 60.948,
  "end": 64.642,
  "text": "Think of a message whispered down a line of people.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 1,
  "start": 65.307,
  "end": 68.737,
  "text": "By the end of a long line, the message has worn thin.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 3,
  "sentence": 0,
  "start": 69.984,
  "end": 81.065,
  "text": "In 2014, Bahdanau, Cho and Bengio let a translation model look at every word of the sentence while it wrote each new word, and weigh how much each one counts.",
  "syllables": 42,
  "seconds": 11.082,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 3,
  "sentence": 1,
  "start": 81.73,
  "end": 84.633,
  "text": "They called it an alignment model.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 3,
  "sentence": 2,
  "start": 85.297,
  "end": 88.2,
  "text": "Today we call the idea attention.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 90.693,
  "end": 92.54,
  "text": "Here is how the looking works.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 93.204,
  "end": 95.051,
  "text": "Every word does three things.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 96.298,
  "end": 97.617,
  "text": "It asks a question.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 98.282,
  "end": 99.865,
  "text": "It holds up a label.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 100.53,
  "end": 102.377,
  "text": "And it carries some cargo.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 103.623,
  "end": 107.845,
  "text": "The word at the end shines its question back along the sentence.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 1,
  "start": 108.51,
  "end": 111.148,
  "text": "Each earlier word answers with its label.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 3,
  "sentence": 0,
  "start": 112.395,
  "end": 114.242,
  "text": "A good match gets a high score.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 3,
  "sentence": 1,
  "start": 114.907,
  "end": 119.92,
  "text": "The scores are turned into shares that add up to one hundred percent.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 4,
  "sentence": 0,
  "start": 121.166,
  "end": 128.29,
  "text": "Then the word takes a blend of the cargo of every word so far, itself included, in those shares.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 4,
  "sentence": 1,
  "start": 128.955,
  "end": 131.33,
  "text": "That blend is what it carries forward.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 133.823,
  "end": 135.406,
  "text": "Let's go inside the lamp.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 136.652,
  "end": 140.346,
  "text": "Every word here is a list of 32 numbers.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 141.011,
  "end": 142.594,
  "text": "One dot is one number.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 143.841,
  "end": 149.645,
  "text": "A match is a dot product: multiply the two lists number by number, and add it all up.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 3,
  "sentence": 0,
  "start": 150.892,
  "end": 158.544,
  "text": "Each head works on a shorter list of its own, 16 numbers here, and the score is divided by the square root of that length.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 3,
  "sentence": 1,
  "start": 159.208,
  "end": 165.277,
  "text": "Without it, long lists give huge scores, the shares go all or nothing, and the model learns slowly.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 4,
  "sentence": 0,
  "start": 166.523,
  "end": 170.481,
  "text": "This is a real model, trained on sentences from our coast.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 4,
  "sentence": 1,
  "start": 171.146,
  "end": 177.742,
  "text": "It has 20,864 numbers in total, and nothing in it was set by hand.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "predict": 0,
  "start": 178.989,
  "end": 181.627,
  "text": "Which earlier word will get most of the light?",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 5,
  "sentence": 0,
  "start": 184.127,
  "end": 190.724,
  "text": "On this sentence, the word at the end gives more than 99 percent of its light to kettle.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 193.217,
  "end": 195.327,
  "text": "One beam asks one kind of question.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 195.992,
  "end": 199.95,
  "text": "A transformer runs several at once, and calls each one a head.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 201.196,
  "end": 208.584,
  "text": "The base transformer in the 2017 paper had eight heads in every attention layer.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 209.249,
  "end": 211.096,
  "text": "The larger one had sixteen.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 212.343,
  "end": 215.245,
  "text": "Ours has 2 heads in each of 2 layers.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 1,
  "start": 215.91,
  "end": 218.284,
  "text": "Nobody told them what to look for.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 3,
  "sentence": 0,
  "start": 219.531,
  "end": 227.446,
  "text": "After training, a head in the second layer puts 71 percent of its light on the word to be copied.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 4,
  "sentence": 0,
  "start": 228.693,
  "end": 237.928,
  "text": "In small attention-only models, researchers at Anthropic found pairs of heads, in different layers, that work together to copy.",
  "syllables": 35,
  "seconds": 9.235,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 4,
  "sentence": 1,
  "start": 238.593,
  "end": 243.078,
  "text": "The first writes into each word a note about the word before it.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 4,
  "sentence": 2,
  "start": 243.743,
  "end": 250.867,
  "text": "The second uses that note to find an earlier copy of the current word, and reads the word that followed it.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 4,
  "sentence": 3,
  "start": 251.532,
  "end": 253.906,
  "text": "They called them induction heads.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 256.399,
  "end": 258.246,
  "text": "Here is the test that matters.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 258.911,
  "end": 265.243,
  "text": "We trained the same model again with the lamp turned off, so each word could see only itself.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 266.49,
  "end": 272.822,
  "text": "With attention, it filled the copy holes correctly 99 percent of the time.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 0,
  "start": 274.069,
  "end": 277.499,
  "text": "With each word seeing only itself, 17 percent.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 3,
  "sentence": 0,
  "start": 278.745,
  "end": 279.801,
  "text": "Then one more run.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 3,
  "sentence": 1,
  "start": 280.466,
  "end": 286.798,
  "text": "Every word got an even share of light over everything before it, with no choosing.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 3,
  "sentence": 2,
  "start": 287.463,
  "end": 289.838,
  "text": "That run reached 64 percent.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 4,
  "sentence": 0,
  "start": 291.084,
  "end": 293.195,
  "text": "Knowing which words came before helps.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 4,
  "sentence": 1,
  "start": 293.86,
  "end": 297.026,
  "text": "Choosing where to look is what finishes the job.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 299.519,
  "end": 300.574,
  "text": "There's a bill.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 301.239,
  "end": 305.725,
  "text": "Every word compares itself with every word before it.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 306.971,
  "end": 311.72,
  "text": "In each head, a thousand words means about half a million comparisons.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 1,
  "start": 312.385,
  "end": 316.607,
  "text": "Double the text, and the attention work goes up about four times.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 0,
  "start": 317.853,
  "end": 322.075,
  "text": "That's why people build special machinery to do this fast.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 1,
  "start": 322.74,
  "end": 326.961,
  "text": "We take it apart in the cannery, in a later lesson.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 329.454,
  "end": 331.301,
  "text": "One warning before you go.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 332.548,
  "end": 335.186,
  "text": "The light shows where a head is reading from.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 1,
  "start": 335.851,
  "end": 340.6,
  "text": "It does not, on its own, tell you why the model answered what it did.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 2,
  "sentence": 0,
  "start": 341.847,
  "end": 351.609,
  "text": "In 2019, researchers showed that in some text classifiers, very different attention patterns can give almost the same answer.",
  "syllables": 37,
  "seconds": 9.763,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 2,
  "sentence": 1,
  "start": 352.274,
  "end": 357.287,
  "text": "Others replied that it depends on what you mean by explain, and proposed tests.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 2,
  "sentence": 2,
  "start": 357.952,
  "end": 360.063,
  "text": "Treat the light as a clue, and check it.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 0,
  "start": 362.556,
  "end": 365.195,
  "text": "The lamp room is open below this film.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 1,
  "start": 365.859,
  "end": 369.289,
  "text": "Train the model yourself, and watch the heads learn where to look.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 1,
  "sentence": 0,
  "start": 370.536,
  "end": 373.966,
  "text": "My voice is synthesized, made from the author's voice.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 }
]
