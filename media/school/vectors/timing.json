[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.275,
  "end": 5.803,
  "text": "Vectors.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 6.483,
  "end": 8.594,
  "text": "A list of numbers is a place.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 9.87,
  "end": 11.716,
  "text": "I run the dock at Night School.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 12.397,
  "end": 16.354,
  "text": "Every crate that comes in gets an address on my chart.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 18.905,
  "end": 19.961,
  "text": "Here is a crate.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 20.641,
  "end": 24.863,
  "text": "It sits four squares east of the corner and one and a half squares north.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 26.138,
  "end": 29.04,
  "text": "Write that down as a list: four, then one and a half.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 29.721,
  "end": 31.304,
  "text": "That list is a vector.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 32.579,
  "end": 37.592,
  "text": "You can read it as a place, or as an arrow from the corner to the crate.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 38.272,
  "end": 39.328,
  "text": "Same list, same thing.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 41.879,
  "end": 42.67,
  "text": "Arrows add.",
  "syllables": 3,
  "seconds": 0.792,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 43.35,
  "end": 47.044,
  "text": "Walk the first one, then walk the second from where you stopped.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 2,
  "start": 47.725,
  "end": 52.738,
  "text": "Where you end up is the sum, and its numbers are the two lists added place by place.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 54.013,
  "end": 54.805,
  "text": "Arrows stretch.",
  "syllables": 3,
  "seconds": 0.792,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 55.485,
  "end": 58.651,
  "text": "Times two keeps the direction and doubles the length.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 2,
  "start": 59.331,
  "end": 63.289,
  "text": "Times minus one turns it round to face the other way.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 65.84,
  "end": 67.423,
  "text": "Now two crates, and a game.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 68.103,
  "end": 71.797,
  "text": "Multiply their lists number by number, and add it all up.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 73.073,
  "end": 77.294,
  "text": "I'll swing the second crate round the corner while the sum keeps count.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "predict": 0,
  "start": 78.57,
  "end": 82.264,
  "text": "As the second crate swings round, where will the sum hit zero?",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 84.764,
  "end": 85.291,
  "text": "Right there.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 1,
  "start": 85.971,
  "end": 88.61,
  "text": "At a right angle, the sum is zero.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 2,
  "start": 89.29,
  "end": 91.665,
  "text": "That sum is called the dot product.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 3,
  "start": 92.345,
  "end": 101.052,
  "text": "It is big when two arrows point the same way, zero when they meet at a right angle, and below zero when they point apart.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 103.603,
  "end": 105.45,
  "text": "The dot product has a catch.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 106.13,
  "end": 111.671,
  "text": "Watch what happens if I push the second crate twice as far out, in the same direction.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "predict": 0,
  "start": 112.946,
  "end": 115.057,
  "text": "What happens to the dot product?",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 117.557,
  "end": 118.349,
  "text": "It doubles.",
  "syllables": 3,
  "seconds": 0.792,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 119.029,
  "end": 122.723,
  "text": "Nothing about the direction changed, but the score did.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 123.998,
  "end": 125.845,
  "text": "So divide by the two lengths.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 1,
  "start": 126.526,
  "end": 129.428,
  "text": "What is left depends only on the angle.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 2,
  "start": 130.108,
  "end": 140.662,
  "text": "It is the cosine of the angle between the arrows: one when they point the same way, zero at a right angle, minus one when they point opposite.",
  "syllables": 40,
  "seconds": 10.554,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 3,
  "start": 141.342,
  "end": 144.509,
  "text": "It always stays between minus one and one.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 147.059,
  "end": 149.434,
  "text": "My chart has two directions, east and north.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 150.114,
  "end": 152.489,
  "text": "A list can be as long as you like.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 153.764,
  "end": 161.416,
  "text": "In the little language model from the attention lesson, every word starts as a list of 32 numbers.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 162.096,
  "end": 166.582,
  "text": "That makes each word a place in a space with 32 directions.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 167.857,
  "end": 171.023,
  "text": "Nobody can picture 32 directions.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 1,
  "start": 171.704,
  "end": 173.814,
  "text": "The arithmetic doesn't care.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 2,
  "start": 174.495,
  "end": 181.355,
  "text": "The dot product is still multiply and add, now 32 times over, and the cosine is still a cosine.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 183.906,
  "end": 186.28,
  "text": "Nobody set those numbers by hand.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 186.961,
  "end": 193.557,
  "text": "Training moved them, a little at a time, until the model got better at guessing the next word.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 194.832,
  "end": 197.471,
  "text": "So look at who ended up close to whom.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 198.151,
  "end": 201.317,
  "text": "The nearest neighbours of kettle are map, shell and crate.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 2,
  "start": 201.997,
  "end": 204.108,
  "text": "Tallow's are rerun, pylon and map.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 0,
  "start": 205.384,
  "end": 216.202,
  "text": "Across all 46 words, 80 percent have a nearest neighbour of the same kind as themselves: names next to names, things next to things, doing words next to doing words.",
  "syllables": 41,
  "seconds": 10.818,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 1,
  "start": 216.882,
  "end": 221.367,
  "text": "Shuffle which word owns which list, and it drops to about 23 percent.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 2,
  "start": 222.047,
  "end": 224.422,
  "text": "Before training it was 9 percent.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 3,
  "sentence": 0,
  "start": 225.698,
  "end": 230.447,
  "text": "Trained on hundreds of millions of words, the same idea goes much further.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 3,
  "sentence": 1,
  "start": 231.127,
  "end": 242.209,
  "text": "In 2013, researchers reported word lists where king, minus man, plus woman, landed closest to queen, once the three words in the question were left out of the search.",
  "syllables": 42,
  "seconds": 11.082,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 244.76,
  "end": 246.343,
  "text": "And then there's my cone.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 247.618,
  "end": 248.937,
  "text": "A cone is cargo.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 1,
  "start": 249.618,
  "end": 251.465,
  "text": "It should sit with the crates.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 2,
  "start": 252.145,
  "end": 254.783,
  "text": "Its nearest neighbours are who, stood and mended.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 0,
  "start": 256.059,
  "end": 261.336,
  "text": "In our sentences a cone only ever turns up in one phrase: put a cone on.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 1,
  "start": 262.016,
  "end": 268.085,
  "text": "Nothing there marks it as cargo, so the model had no reason to park it with the crates.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 2,
  "start": 268.765,
  "end": 272.195,
  "text": "Where it did park it is something we measured.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 3,
  "start": 272.875,
  "end": 274.722,
  "text": "Why there, we can only guess.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 3,
  "sentence": 0,
  "start": 275.997,
  "end": 283.121,
  "text": "Closeness in these lists comes from how words are used in the training sentences, not from what they mean.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 3,
  "sentence": 1,
  "start": 283.802,
  "end": 289.079,
  "text": "Here, with 46 words, you can read every sentence the model learned from.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 291.63,
  "end": 295.323,
  "text": "One warning about pictures, this lesson's included.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 296.599,
  "end": 303.723,
  "text": "To lay the words out on my flat chart, I squash 32 directions down to the two that keep the most spread.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 1,
  "start": 304.403,
  "end": 307.042,
  "text": "Those two keep 31 percent of it.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 2,
  "sentence": 0,
  "start": 308.317,
  "end": 314.649,
  "text": "On the flat chart, only 52 percent of the words sit nearest to a word of the same kind.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 2,
  "sentence": 1,
  "start": 315.33,
  "end": 318.496,
  "text": "In all 32 directions it was 80.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 2,
  "sentence": 2,
  "start": 319.176,
  "end": 322.606,
  "text": "Flattening throws a lot of closeness away.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 0,
  "start": 325.157,
  "end": 327.268,
  "text": "A list of numbers is a place.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 1,
  "start": 327.948,
  "end": 336.655,
  "text": "The dot product mixes how much two places point the same way with how far out they are, and the cosine keeps only the direction.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 1,
  "sentence": 0,
  "start": 337.931,
  "end": 340.041,
  "text": "Next along the coast is my crane.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 1,
  "sentence": 1,
  "start": 340.722,
  "end": 345.207,
  "text": "It moves every place on the chart at once, and that is a matrix.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 1,
  "sentence": 2,
  "start": 345.887,
  "end": 346.415,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
