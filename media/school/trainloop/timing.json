[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.579,
  "end": 6.634,
  "text": "The training loop.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 7.476,
  "end": 9.323,
  "text": "Five steps, two thousand times.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 10.902,
  "end": 14.86,
  "text": "Every lesson so far has a piece of training in it.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 15.702,
  "end": 23.354,
  "text": "Tonight they go round together, and we watch the whole loop teach the attention model, from the first step to the last.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 26.512,
  "end": 27.831,
  "text": "One lap goes like this.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 28.673,
  "end": 31.839,
  "text": "Take a batch of 16 rows from the training text.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 2,
  "start": 32.681,
  "end": 36.903,
  "text": "Run the model forward and score every next word: that is the loss.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 38.482,
  "end": 45.87,
  "text": "Run backward to get the slope for every one of the model's 20,864 numbers.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 46.712,
  "end": 49.878,
  "text": "Then the optimiser takes one step downhill.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 2,
  "start": 50.72,
  "end": 51.776,
  "text": "That is one lap.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 53.354,
  "end": 63.645,
  "text": "On one core of our test machine, with this lesson's own code, a lap takes about 21 milliseconds, and most of that is the backward pass: 14 of them.",
  "syllables": 39,
  "seconds": 10.29,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 66.803,
  "end": 74.982,
  "text": "The optimiser is Adam, with a little weight decay that shrinks most of the numbers slightly each step, as in AdamW.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 75.824,
  "end": 78.99,
  "text": "The layer norms' gains and the biases are left out.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 80.569,
  "end": 86.11,
  "text": "The step size starts tiny and grows over the first 30 laps to 0.01.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 86.952,
  "end": 88.008,
  "text": "That is warmup.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 89.587,
  "end": 98.294,
  "text": "And if the whole slope, all the numbers taken together, is ever longer than 1, it is shortened to 1 before the step.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 1,
  "start": 99.136,
  "end": 100.191,
  "text": "That is clipping.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 2,
  "start": 101.033,
  "end": 108.157,
  "text": "It fired on 76 of the 2,000 laps, 62 of them in the first 250.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 111.315,
  "end": 112.107,
  "text": "Now run it.",
  "syllables": 3,
  "seconds": 0.792,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 112.949,
  "end": 117.17,
  "text": "At lap zero, the held-out loss is 3.84, a blind guess.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 118.749,
  "end": 125.873,
  "text": "By lap 100 it is 0.97: the easy patterns, which word tends to follow which, come first.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "predict": 0,
  "start": 127.452,
  "end": 132.465,
  "text": "Will copying a word from far back be learned early, late, or bit by bit?",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 134.965,
  "end": 138.395,
  "text": "Copying a word from far back comes late, and then fast.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 1,
  "start": 139.238,
  "end": 143.987,
  "text": "At lap 500, copying is right 43 percent of the time.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 2,
  "start": 144.829,
  "end": 148.787,
  "text": "By lap 750, 97 percent.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 3,
  "sentence": 0,
  "start": 150.366,
  "end": 160.392,
  "text": "We ran the loop again from the same seeds, and got the attention lesson's model back exactly: 29 of 29 weight tables, number for number.",
  "syllables": 38,
  "seconds": 10.026,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 163.55,
  "end": 167.508,
  "text": "Change one setting at a time, train for 1,000 laps, and compare.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 168.35,
  "end": 182.334,
  "text": "First, the noise: the same recipe on two other sets of training rows ends at 0.70 and 0.70, and the original at 0.70, all three within a few thousandths.",
  "syllables": 53,
  "seconds": 13.984,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 2,
  "start": 183.176,
  "end": 187.398,
  "text": "A difference smaller than that cannot be told apart from luck.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 188.977,
  "end": 196.628,
  "text": "A step size ten times smaller ends at 0.78, and copies right only 54 percent of the time.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "predict": 0,
  "start": 197.47,
  "end": 200.9,
  "text": "Make the step size ten times larger. Faster, or worse?",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 203.4,
  "end": 208.941,
  "text": "Ten times larger ends worse, at 0.95, copying 22 percent.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 210.52,
  "end": 215.006,
  "text": "Without weight decay: 0.70, inside the noise.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 1,
  "start": 215.848,
  "end": 220.597,
  "text": "On this small model, at this length, it makes no difference we can see.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 3,
  "sentence": 0,
  "start": 222.176,
  "end": 229.3,
  "text": "Batches of 4 rows for the same number of laps see a quarter of the text, and end at 0.87.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 3,
  "sentence": 1,
  "start": 230.142,
  "end": 236.211,
  "text": "Given the same text over four times the laps, they still end at 0.76.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 239.369,
  "end": 240.952,
  "text": "Two broken loops, as checks.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 241.794,
  "end": 247.071,
  "text": "With a step size of zero, nothing moves: the loss stays at 3.84.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 248.65,
  "end": 253.927,
  "text": "Turn every slope around, so each step goes uphill, and the loss climbs to 68.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 254.769,
  "end": 258.463,
  "text": "The loop only works because the slope points the right way.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 261.621,
  "end": 263.468,
  "text": "Batch, forward, loss, backward, step.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 264.31,
  "end": 268.795,
  "text": "Two thousand times, and a blind guess becomes a model that copies.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 270.374,
  "end": 273.276,
  "text": "Next on the dock: what goes into the batches.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 274.119,
  "end": 274.646,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
