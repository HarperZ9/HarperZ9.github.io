[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.597,
  "end": 6.917,
  "text": "Next-word prediction.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 7.769,
  "end": 10.143,
  "text": "One guess, spread over every word.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 11.741,
  "end": 17.281,
  "text": "A language model is first trained on one job: read some words, and say what comes next.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 18.133,
  "end": 21.3,
  "text": "Tonight, what that guess looks like, and how it is scored.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 24.494,
  "end": 30.563,
  "text": "Take the small model from the attention lesson, give it one word, pylon, and ask what comes next.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 32.16,
  "end": 34.271,
  "text": "It does not answer with one word.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 35.123,
  "end": 46.205,
  "text": "It cuts the wheel into a slot for every word, some wider than others: found gets 50 percent of its belief, painted about 9, and the rest is shared out thinner.",
  "syllables": 42,
  "seconds": 11.082,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 47.802,
  "end": 52.024,
  "text": "We know the rules that wrote these sentences, so we can check it.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 52.876,
  "end": 57.361,
  "text": "After pylon, the rules choose found 42 percent of the time.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 2,
  "start": 58.213,
  "end": 61.115,
  "text": "From examples alone, the model got close.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 64.31,
  "end": 67.213,
  "text": "Inside, the model ends with one score per word.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 68.064,
  "end": 74.661,
  "text": "Scores can be any number, even below zero, so they are not yet a share of belief.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 76.258,
  "end": 79.688,
  "text": "Take four words with scores 2, 1, 0 and minus 1.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 80.54,
  "end": 86.345,
  "text": "Raise e to each score, which makes every one positive, then divide by their total.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 87.942,
  "end": 91.9,
  "text": "The shares come out 64, 24, 9 and 3 percent.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 1,
  "start": 92.752,
  "end": 96.974,
  "text": "A score one higher means about 2.7 times the share.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 2,
  "start": 97.826,
  "end": 99.936,
  "text": "This step is called the softmax.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 103.131,
  "end": 105.242,
  "text": "Then the real next word arrives.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 106.094,
  "end": 109.524,
  "text": "Say it was lamp, the word with 64 percent.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 111.121,
  "end": 116.926,
  "text": "The score for the guess is the surprise: minus the log of the share it gave the word that came.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 117.778,
  "end": 119.889,
  "text": "Here that is 0.44.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 121.486,
  "end": 125.708,
  "text": "Give the right word half, and the surprise is about 0.69.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "predict": 0,
  "start": 126.56,
  "end": 132.628,
  "text": "If the model had given the right word every bit of its belief, what would the loss be?",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 1,
  "start": 135.128,
  "end": 138.558,
  "text": "Give it all of its belief, and the surprise is zero.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 2,
  "start": 139.41,
  "end": 143.104,
  "text": "Give it almost nothing, and the surprise grows without limit.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 3,
  "start": 143.956,
  "end": 148.178,
  "text": "This number is the loss, and training is the work of making it small.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 3,
  "sentence": 0,
  "start": 149.775,
  "end": 155.052,
  "text": "The slope of the loss for each score is that word's share, minus one for the word that came.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 3,
  "sentence": 1,
  "start": 155.904,
  "end": 164.347,
  "text": "Training steps the other way: the right word's score goes up, and every other score comes down, each by an amount set by its share.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 3,
  "sentence": 2,
  "start": 165.199,
  "end": 169.685,
  "text": "We checked that rule against tiny test nudges, and they agree.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 3,
  "sentence": 3,
  "start": 170.537,
  "end": 174.231,
  "text": "A version with the minus one left out fails the same check.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 177.425,
  "end": 180.855,
  "text": "A loss in logs is hard to picture, so turn it back.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 181.707,
  "end": 190.678,
  "text": "Raise e to the average surprise, and you get how many words the guesses are torn between, as if they were all equally likely.",
  "syllables": 34,
  "seconds": 8.971,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 2,
  "start": 191.53,
  "end": 193.641,
  "text": "That is called perplexity.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 3,
  "start": 194.493,
  "end": 199.506,
  "text": "The same count can be read off a single guess, before any word arrives.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 201.103,
  "end": 207.7,
  "text": "After rerun knocked, the rules allow two words, on or twice, half each: torn between exactly 2.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 208.552,
  "end": 211.982,
  "text": "The model's guess there: torn between 2.04.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 213.579,
  "end": 218.065,
  "text": "After tallow found a, the rules allow 10 things, all equally.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 1,
  "start": 218.916,
  "end": 227.096,
  "text": "The model is torn between 10.07, but it leans: it gives kettle 14 percent where the rules give 10.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 230.291,
  "end": 238.734,
  "text": "Now score it properly, on 6,144 next words from rows it never trained on, against simpler guessers.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 239.586,
  "end": 245.918,
  "text": "The rows are new; the sentences in them are not, because the rules can only make so many.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 247.516,
  "end": 250.682,
  "text": "A blind guess is torn between all 46 words.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 251.534,
  "end": 256.811,
  "text": "Counting how often each word appears gets that down to 26.37.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 2,
  "start": 257.663,
  "end": 260.829,
  "text": "Counting which word follows which: 3.60.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 3,
  "start": 261.681,
  "end": 264.319,
  "text": "Which word follows each pair: 2.91.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 265.917,
  "end": 269.347,
  "text": "The attention model: torn between 1.99.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 3,
  "sentence": 0,
  "start": 270.944,
  "end": 278.332,
  "text": "The gap is widest where a word must come back from far earlier, like the cone going on the thing found seven words before.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 3,
  "sentence": 1,
  "start": 279.184,
  "end": 286.308,
  "text": "There, counting which word follows which is torn between 7.11 and the model between 1.06.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 3,
  "sentence": 2,
  "start": 287.16,
  "end": 289.271,
  "text": "That is what attention is for.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "predict": 0,
  "start": 292.465,
  "end": 297.215,
  "text": "Can any guesser get to torn between one, never surprised at all?",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 299.715,
  "end": 303.673,
  "text": "No. Some next words are a coin toss in the rules themselves.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 304.524,
  "end": 309.802,
  "text": "Even the rules, scoring their own sentences, are torn between 1.93.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 2,
  "start": 310.653,
  "end": 311.709,
  "text": "That is the floor.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 313.306,
  "end": 320.958,
  "text": "Over 2,000 training steps, the model's loss on those held-out rows fell from 3.84 to 0.69.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 321.81,
  "end": 323.921,
  "text": "The floor is 0.66.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 2,
  "start": 324.773,
  "end": 328.203,
  "text": "What is left above it is 0.03.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 0,
  "start": 329.8,
  "end": 333.494,
  "text": "We can say that only because we wrote the rules.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 1,
  "start": 334.346,
  "end": 341.998,
  "text": "For real text nobody knows exactly where the floor is, so nobody can say how much lower a loss could go.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 345.192,
  "end": 348.886,
  "text": "A guess is a spread of belief over every word.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 349.738,
  "end": 355.279,
  "text": "The loss is the surprise when the real word arrives, and training makes the surprise small.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 356.876,
  "end": 361.362,
  "text": "Next in the lighthouse: how the attention lamp chooses what to look at.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 1,
  "start": 362.214,
  "end": 362.741,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
