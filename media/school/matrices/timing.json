[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.478,
  "end": 6.798,
  "text": "Matrices move space.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 8.276,
  "end": 11.442,
  "text": "Last time every crate got a place on my chart.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 12.231,
  "end": 15.133,
  "text": "Tonight the crane moves all of them at once.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 18.09,
  "end": 20.729,
  "text": "A crane that lifts one crate is useful.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 21.517,
  "end": 28.905,
  "text": "This crane takes the whole chart, and every crate on it, and turns it, or stretches it, or leans it over, in one go.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 30.384,
  "end": 34.605,
  "text": "A matrix is that kind of move written as a grid of numbers.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 35.394,
  "end": 42.518,
  "text": "It sends every place on the chart somewhere, it keeps straight lines straight, and it leaves the corner where it is.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 45.475,
  "end": 47.058,
  "text": "Here's how to read one.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 47.846,
  "end": 53.123,
  "text": "Forget the crates and watch two short arrows from the corner: one step east, one step north.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 54.602,
  "end": 58.56,
  "text": "The first column of the matrix says where the east step lands.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 59.348,
  "end": 62.514,
  "text": "The second column says where the north step lands.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 63.993,
  "end": 66.631,
  "text": "That is all a matrix has to say.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 1,
  "start": 67.42,
  "end": 77.182,
  "text": "Every place on the chart is so many east steps plus so many north steps, so it lands at the same number of the new east steps plus the new north steps.",
  "syllables": 37,
  "seconds": 9.763,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 80.139,
  "end": 83.042,
  "text": "A quarter turn sends east to north, and north to west.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 83.83,
  "end": 86.469,
  "text": "Columns: zero, one, and minus one, zero.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 87.947,
  "end": 91.377,
  "text": "A stretch sends east to two steps east and leaves north alone.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 92.166,
  "end": 98.234,
  "text": "Every patch of the dock gets twice the area, and that factor has a name: the determinant.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 99.713,
  "end": 104.198,
  "text": "A lean, called a shear, slides the top of the chart sideways.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 1,
  "start": 104.987,
  "end": 110.528,
  "text": "Squares become slanted boxes, and yet the area stays the same: determinant one.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 113.485,
  "end": 115.859,
  "text": "Two cranes, one after the other.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 116.648,
  "end": 119.286,
  "text": "The first stretches the dock east, twice as wide.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 2,
  "start": 120.075,
  "end": 122.45,
  "text": "The second turns it a quarter turn.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "predict": 0,
  "start": 123.928,
  "end": 126.039,
  "text": "Does it matter which crane goes first?",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 128.539,
  "end": 132.233,
  "text": "Stretch then turn sends the east step to 0, 2: two steps north.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 133.021,
  "end": 136.187,
  "text": "Turn then stretch sends it to 0, 1: one step north.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 2,
  "start": 136.976,
  "end": 138.823,
  "text": "So yes, the order matters.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 140.301,
  "end": 145.578,
  "text": "Two moves in a row are still one move, and its matrix is the product of the two.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 1,
  "start": 146.367,
  "end": 154.283,
  "text": "Multiplying matrices means doing the moves one after the other, and that is why the order of a product matters.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 157.239,
  "end": 158.823,
  "text": "Here's a harder one.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "predict": 0,
  "start": 160.301,
  "end": 163.467,
  "text": "Can any matrix move the corner of the chart?",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 165.967,
  "end": 173.355,
  "text": "No. A matrix times a list of zeros gives a list of zeros, so the corner always stays put.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 174.144,
  "end": 178.893,
  "text": "To slide the whole chart over, you add a fixed list after the move.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 180.371,
  "end": 186.704,
  "text": "Many language models do exactly that: a matrix, then a list added on, called a bias.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 1,
  "start": 187.492,
  "end": 192.506,
  "text": "Every layer of the model from the attention lesson does it.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 195.463,
  "end": 202.059,
  "text": "Back at the lighthouse, in the attention lesson, the word 'the' asked a question and kettle answered.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 202.847,
  "end": 205.486,
  "text": "Tallow skipped how the question was made.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 2,
  "start": 206.274,
  "end": 207.594,
  "text": "A matrix made it.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 209.072,
  "end": 217.779,
  "text": "By the second layer, the list of 32 numbers at each word has been through a step called layer normalisation.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 218.568,
  "end": 226.747,
  "text": "It shifts the numbers to average zero and scales them to a standard spread, then applies a learned scale and shift of its own.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 2,
  "start": 227.536,
  "end": 233.077,
  "text": "Then it meets the head's query matrix: 32 rows by 16 columns, plus a bias.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 0,
  "start": 234.555,
  "end": 237.985,
  "text": "Out comes the question, a list of 16 numbers.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 1,
  "start": 238.774,
  "end": 245.898,
  "text": "Kettle's list goes through a different matrix, the key matrix, and comes out as a label of the same length.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 3,
  "sentence": 0,
  "start": 247.376,
  "end": 253.445,
  "text": "Multiply the question and the label number by number and add it up: 41.28.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 3,
  "sentence": 1,
  "start": 254.233,
  "end": 257.927,
  "text": "Divide by 4, the square root of 16: 10.32.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 3,
  "sentence": 2,
  "start": 258.716,
  "end": 263.729,
  "text": "That is the score the attention film showed, rebuilt here from the trained weights.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 266.686,
  "end": 270.38,
  "text": "A matrix can only do moves that keep lines straight.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 271.168,
  "end": 274.862,
  "text": "Stack ten of them and you still have one straight-line move: their product.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 276.341,
  "end": 279.507,
  "text": "So a model puts bends between its matrices.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 1,
  "start": 280.295,
  "end": 292.169,
  "text": "In the one from the attention lesson, a smooth curve called GELU sits between the two matrices in the second half of each layer and bends every number that passes through.",
  "syllables": 45,
  "seconds": 11.873,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 2,
  "start": 292.957,
  "end": 296.915,
  "text": "The softmax and the layer normalisation bend things too.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 0,
  "start": 298.394,
  "end": 304.726,
  "text": "How a model learns the numbers in its matrices is where the next lessons along the hill go.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 307.683,
  "end": 310.585,
  "text": "A matrix moves every place at once.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 1,
  "start": 311.374,
  "end": 318.498,
  "text": "Read its columns to see where the steps go, multiply two to do one move after another, and mind the order.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 319.976,
  "end": 323.67,
  "text": "Next along the hill, we find out which way is downhill.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 1,
  "start": 324.459,
  "end": 324.986,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
