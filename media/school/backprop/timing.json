[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.54,
  "end": 6.86,
  "text": "Backpropagation.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 7.681,
  "end": 9.0,
  "text": "Blame, passed backwards.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 10.541,
  "end": 13.443,
  "text": "Last time I could feel the slope for two numbers.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 14.264,
  "end": 15.848,
  "text": "A model has thousands.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 2,
  "start": 16.669,
  "end": 19.835,
  "text": "Tonight, how it gets all their slopes in one go.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 22.916,
  "end": 24.499,
  "text": "Here is a small network.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 25.32,
  "end": 30.597,
  "text": "It looks at a point on a map and says which of two spirals the point belongs to.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 32.138,
  "end": 34.512,
  "text": "It has 114 numbers.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 35.334,
  "end": 42.458,
  "text": "Two go in at the top, pass through two layers of 8 buckets each, and come out as two guesses at the bottom.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 43.998,
  "end": 52.705,
  "text": "Every bucket in the middle takes what the buckets above hand it, weighs it, adds it up, and squashes the total through a smooth curve.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 53.527,
  "end": 58.012,
  "text": "The last two turn their totals into two guesses that add up to one.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 2,
  "start": 58.834,
  "end": 60.417,
  "text": "That's the forward pass.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 63.497,
  "end": 66.927,
  "text": "At the bottom we measure how wrong it was: the loss.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 67.749,
  "end": 71.179,
  "text": "Now we want each of the 114 slopes.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 72.719,
  "end": 78.26,
  "text": "The slow way: nudge one number, run the whole chain again, see how the loss moved.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 79.082,
  "end": 82.248,
  "text": "That's one extra run for every number.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 2,
  "start": 83.069,
  "end": 92.04,
  "text": "For the model from the attention lesson, that's 20,864 runs, for every single step of training.",
  "syllables": 34,
  "seconds": 8.971,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 95.121,
  "end": 98.551,
  "text": "The fast way runs the chain once, then walks it backwards.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "predict": 0,
  "start": 100.091,
  "end": 104.049,
  "text": "How many backward walks does it take to get all the slopes?",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 106.549,
  "end": 112.09,
  "text": "Each bucket at the bottom knows how much the loss changes when its own output changes.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 112.911,
  "end": 120.827,
  "text": "It hands that blame up to each bucket that fed it, multiplied by how much its own output moved when that input moved.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 121.648,
  "end": 128.772,
  "text": "A bucket that fed several adds up the blame from all of them, then does the same, all the way to the top.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 130.313,
  "end": 134.007,
  "text": "That's the chain rule from school, done in reverse order.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 1,
  "start": 134.828,
  "end": 148.285,
  "text": "Seppo Linnainmaa worked out this reverse order in 1970, and in 1986 Rumelhart, Hinton and Williams showed what it could do for training networks.",
  "syllables": 51,
  "seconds": 13.456,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 151.365,
  "end": 151.629,
  "text": "One.",
  "syllables": 1,
  "seconds": 0.264,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 152.451,
  "end": 155.881,
  "text": "A single walk back hands every number its slope.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 157.421,
  "end": 169.294,
  "text": "Counting multiply-adds for one point, and leaving the curves aside: the forward pass takes 98, the backward pass 208, about 2.12 times as many.",
  "syllables": 45,
  "seconds": 11.873,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 170.116,
  "end": 172.49,
  "text": "Not 114 extra runs.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 2,
  "start": 173.312,
  "end": 174.631,
  "text": "About two runs' worth.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 177.712,
  "end": 183.253,
  "text": "A walk back like this is easy to get slightly wrong, so we check it the slow way.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 184.074,
  "end": 186.185,
  "text": "Nudge every number, compare.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 187.725,
  "end": 199.071,
  "text": "After training, they agree layer by layer to about one part in a billion, and the worst single number is off by about three parts in a hundred million.",
  "syllables": 43,
  "seconds": 11.346,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 200.611,
  "end": 206.68,
  "text": "Now I break one link on purpose: in the second layer, the curve's slope is written wrong.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 1,
  "start": 207.501,
  "end": 215.417,
  "text": "The check fails in that layer and every layer above it, and still passes in the last layer, below the break.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 2,
  "start": 216.238,
  "end": 219.404,
  "text": "The check doesn't just say something is wrong.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 3,
  "start": 220.226,
  "end": 221.281,
  "text": "It points to where.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 224.362,
  "end": 231.486,
  "text": "Now put it together with last time: walk forward, walk back, step every number a little downhill, repeat.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 233.026,
  "end": 238.831,
  "text": "On points it never trained on, the network starts out right 36 percent of the time.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 239.652,
  "end": 247.832,
  "text": "It is past 95 percent by step 2,000, and after 4,000 steps it gets 99.8 percent right.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 250.912,
  "end": 262.522,
  "text": "The model from the attention lesson walks forward and back the same way, with a backward pass written out by hand for every part: the attention, the layer norms, the bends.",
  "syllables": 44,
  "seconds": 11.609,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 263.343,
  "end": 267.301,
  "text": "It steps downhill a little more cleverly, and that's next time.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 268.841,
  "end": 273.327,
  "text": "We checked it the slow way too, on 36 of its numbers.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 1,
  "start": 274.148,
  "end": 279.162,
  "text": "In full precision the worst disagreement is a few parts in ten million.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 282.242,
  "end": 286.728,
  "text": "Run forward once, pass the blame back once, and every number knows its slope.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 288.268,
  "end": 292.226,
  "text": "Next along the hill: better ways to step than straight downhill.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 1,
  "start": 293.047,
  "end": 293.575,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
