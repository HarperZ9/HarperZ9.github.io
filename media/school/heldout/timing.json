[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.512,
  "end": 6.567,
  "text": "The held-out set.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 0,
  "sentence": 1,
  "start": 7.373,
  "end": 9.22,
  "text": "Learning, or remembering?",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 10.732,
  "end": 14.69,
  "text": "I could learn this harbour by heart, every crate in its place.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 15.496,
  "end": 19.19,
  "text": "Then one night they send me to a different harbour.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 22.213,
  "end": 23.533,
  "text": "Here are 16 points.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 1,
  "start": 24.339,
  "end": 29.88,
  "text": "They come from a smooth curve, plus a little noise, the way real measurements do.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 31.391,
  "end": 32.975,
  "text": "Let's fit a curve through them.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 1,
  "start": 33.781,
  "end": 35.628,
  "text": "A straight line misses the bend.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 2,
  "start": 36.434,
  "end": 38.281,
  "text": "A gentle curve follows it.",
  "syllables": 7,
  "seconds": 1.847,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 3,
  "start": 39.087,
  "end": 43.837,
  "text": "And a wild one, with enough freedom, passes through every single point.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "predict": 0,
  "start": 45.348,
  "end": 48.514,
  "text": "Which curve will do best on points it has never seen?",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 51.014,
  "end": 57.611,
  "text": "The wild one gets every point right: its error on them is about one part in a hundred billion.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 58.417,
  "end": 62.375,
  "text": "That's zero, apart from rounding in the arithmetic.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 65.398,
  "end": 66.717,
  "text": "So keep some points back.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 1,
  "start": 67.524,
  "end": 72.009,
  "text": "500 of them, drawn the same way, never used for fitting.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 2,
  "start": 72.815,
  "end": 74.399,
  "text": "That's the held-out set.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 75.91,
  "end": 79.868,
  "text": "On those, the gentle curve's error is 0.33.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 80.674,
  "end": 84.368,
  "text": "The wild one's is 3,936.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 2,
  "start": 85.174,
  "end": 91.243,
  "text": "Between the points it learned it swings wildly, and past the outermost ones it shoots off the chart.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 92.755,
  "end": 99.087,
  "text": "Make the curve more flexible, step by step, and the error on the training points only ever goes down.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 1,
  "start": 99.893,
  "end": 105.962,
  "text": "The error on the held-out points goes down, then turns around and climbs, with a few bumps on the way.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 108.985,
  "end": 114.79,
  "text": "One fix is a leash: keep the wild curve, but charge it for every large number it uses.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 116.302,
  "end": 123.69,
  "text": "A moderate charge brings its held-out error down from 3,936 to 0.43.",
  "syllables": 28,
  "seconds": 7.388,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 1,
  "start": 124.496,
  "end": 132.675,
  "text": "That's the best of seven charges we tried, picked by looking at these same held-out points, so it flatters the leash a little.",
  "syllables": 31,
  "seconds": 8.179,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 2,
  "start": 133.482,
  "end": 139.286,
  "text": "Pull too hard and it gets worse again: at the heaviest pull we tried, 0.70.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 142.31,
  "end": 146.795,
  "text": "The bucket chain from last time learned two spirals from 400 points.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 147.601,
  "end": 149.185,
  "text": "Give it only 40.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 150.696,
  "end": 153.335,
  "text": "It still gets every training point right.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 1,
  "start": 154.141,
  "end": 162.057,
  "text": "On new points it's right 78.3 percent of the time, against 99.5 with all 400.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 163.568,
  "end": 164.888,
  "text": "Watch the held-out loss.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 1,
  "start": 165.694,
  "end": 171.499,
  "text": "It's lowest early, at step 300, and then climbs while the training loss keeps falling.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 2,
  "start": 172.305,
  "end": 182.331,
  "text": "Its score on new points still creeps up for a while, to 80 percent by step 1,000, but it grows ever more sure of itself, wrong answers included.",
  "syllables": 38,
  "seconds": 10.026,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 3,
  "start": 183.137,
  "end": 188.942,
  "text": "After that the score stops improving, and training only tightens its grip on these forty points.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 191.966,
  "end": 194.868,
  "text": "And a score from one training set is one draw.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 1,
  "start": 195.674,
  "end": 204.381,
  "text": "Pick five different sets of 40 training points, and the held-out score runs from 75.5 to 86.0 percent.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 205.893,
  "end": 208.795,
  "text": "Even which curve looks best depends on the draw.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 209.602,
  "end": 217.253,
  "text": "Over two hundred draws of sixteen points, the gentle curve came out best 113 times, not every time.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 220.277,
  "end": 228.72,
  "text": "The language model from the attention lesson was trained on a stream of freshly made sentences, a new batch every step.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 229.526,
  "end": 238.761,
  "text": "Its little grammar does repeat itself: 507 of its 32,000 training rows were exact copies of earlier ones.",
  "syllables": 35,
  "seconds": 9.235,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 2,
  "start": 239.567,
  "end": 245.9,
  "text": "But no row came round more than 5 times, so it had little chance to learn its training rows by heart.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 247.411,
  "end": 253.48,
  "text": "Score the finished model on rows it trained on, and its loss is about 0.63.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 254.286,
  "end": 259.563,
  "text": "On the next stretch of the same stream, which it didn't train on, 0.67.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 2,
  "start": 260.369,
  "end": 261.953,
  "text": "A small gap, not a chasm.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 0,
  "start": 263.464,
  "end": 275.074,
  "text": "And its own held-out set turns out to be a little hard: 0.69, higher than five fresh draws of the same size, which range from 0.65 to 0.67.",
  "syllables": 44,
  "seconds": 11.609,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 278.097,
  "end": 280.472,
  "text": "One rule makes all of this work.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 281.278,
  "end": 288.93,
  "text": "Once you use the held-out points to choose anything, how flexible the curve is, how long to train, they stop being held out.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 290.442,
  "end": 296.774,
  "text": "So careful work keeps a third set locked away until the very end, and looks at it once.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 299.797,
  "end": 302.436,
  "text": "Getting the practice right is not the test.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 1,
  "start": 303.242,
  "end": 304.825,
  "text": "Keep points back, and check on those.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 306.337,
  "end": 307.656,
  "text": "That's the hill done.",
  "syllables": 5,
  "seconds": 1.319,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 1,
  "start": 308.462,
  "end": 311.629,
  "text": "Next, down at the dock, we cut words into crates.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 2,
  "start": 312.435,
  "end": 312.963,
  "text": "Goodnight.",
  "syllables": 2,
  "seconds": 0.528,
  "provisional": true,
  "accepted": true
 }
]
