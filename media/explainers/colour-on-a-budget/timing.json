[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.409,
  "end": 6.992,
  "text": "Colour on a budget.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 9.809,
  "end": 19.308,
  "text": "In 1987, an IBM PC with VGA graphics had a mode of 320 by 200 pixels, one byte each.",
  "syllables": 36,
  "seconds": 9.499,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 20.716,
  "end": 33.645,
  "text": "A byte holds 256 values, so the screen showed 256 colours at once, each one picked from a palette of 262,144.",
  "syllables": 49,
  "seconds": 12.929,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 40.371,
  "end": 47.495,
  "text": "In 1982, Paul Heckbert described a way to choose them, called median cut.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 48.904,
  "end": 52.598,
  "text": "Put every colour in the picture into a box.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 53.349,
  "end": 62.056,
  "text": "Cut the box in two at the median of its longest side, and keep cutting the biggest piece until there are 256 boxes.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 63.465,
  "end": 69.797,
  "text": "Each box becomes one palette colour, and each colour stands for about the same number of pixels.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 3,
  "sentence": 0,
  "start": 71.206,
  "end": 76.483,
  "text": "He found pictures could drop to 8 bits per pixel with little visible loss.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 79.3,
  "end": 83.786,
  "text": "When a smooth sky turns into stripes, the obvious fix is more colours.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 84.537,
  "end": 90.606,
  "text": "There is another way: keep the error, and spread it where the eye will average it out.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 93.423,
  "end": 96.589,
  "text": "In 1973, B.",
  "syllables": 12,
  "seconds": 3.166,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 97.341,
  "end": 97.604,
  "text": "E.",
  "syllables": 1,
  "seconds": 0.264,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 2,
  "start": 98.356,
  "end": 101.258,
  "text": "Bayer published a pattern for this.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 3,
  "start": 102.009,
  "end": 107.55,
  "text": "Compare each pixel with a threshold from a small grid that repeats across the image.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 108.959,
  "end": 114.236,
  "text": "With an 8 by 8 grid, black and white alone can show 65 levels of grey.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 117.053,
  "end": 126.024,
  "text": "In the mid-1970s, Floyd and Steinberg passed each pixel's rounding error on to the neighbours not yet drawn.",
  "syllables": 34,
  "seconds": 8.971,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 127.433,
  "end": 129.544,
  "text": "Seven sixteenths go to the right.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 130.295,
  "end": 133.197,
  "text": "Three, five and one sixteenths go to the row below.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 134.606,
  "end": 140.147,
  "text": "The noise is fine enough that the eye blends it back into the colour that was meant.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 142.964,
  "end": 151.671,
  "text": "A third way uses a grid of thresholds with no clumps and no repeats you can see, built by Robert Ulichney's void-and-cluster method.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 153.08,
  "end": 155.982,
  "text": "It reads as fine grain instead of a pattern.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 158.8,
  "end": 169.618,
  "text": "Which palette colour is nearest depends on how you measure. raw-native measures in Oklab, a colour space designed so that equal steps look roughly equal.",
  "syllables": 41,
  "seconds": 10.818,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 172.435,
  "end": 175.865,
  "text": "raw-native's dither pass runs on the graphics card.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 1,
  "start": 176.616,
  "end": 188.49,
  "text": "For two palettes, it picks the same colour as the slow reference for every one of 16,777,216 colours.",
  "syllables": 45,
  "seconds": 11.873,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 189.898,
  "end": 201.508,
  "text": "BRender, from 1998, kept its textures the same way: each texel is an 8-bit index into a 256-colour palette.",
  "syllables": 44,
  "seconds": 11.609,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 0,
  "start": 204.325,
  "end": 205.381,
  "text": "Two things to keep.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 1,
  "start": 206.132,
  "end": 208.506,
  "text": "Pick the colours where the pixels are.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 2,
  "start": 209.258,
  "end": 213.479,
  "text": "Spend the error where the eye averages it away.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 1,
  "sentence": 0,
  "start": 214.888,
  "end": 218.582,
  "text": "The voice you heard is a synthesized version of mine.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 1,
  "sentence": 1,
  "start": 219.333,
  "end": 223.555,
  "text": "Every number on screen links to its source under the video.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 }
]
