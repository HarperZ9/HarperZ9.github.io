[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.493,
  "end": 7.076,
  "text": "Colour on a budget.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 10.062,
  "end": 19.56,
  "text": "In 1987, an IBM PC with VGA graphics had a mode of 320 by 200 pixels, one byte each.",
  "syllables": 36,
  "seconds": 9.499,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 21.053,
  "end": 33.982,
  "text": "A byte holds 256 values, so the screen showed 256 colours at once, each one picked from a palette of 262,144.",
  "syllables": 49,
  "seconds": 12.929,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "predict": 0,
  "start": 36.967,
  "end": 42.244,
  "text": "A photograph has thousands of colours. Which 256 would you keep?",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 44.744,
  "end": 51.868,
  "text": "In 1982, Paul Heckbert described a way to choose them, called median cut.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 53.361,
  "end": 57.055,
  "text": "Put every colour in the picture into a box.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 57.851,
  "end": 66.558,
  "text": "Cut the box in two at the median of its longest side, and keep cutting the biggest piece until there are 256 boxes.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 68.051,
  "end": 74.384,
  "text": "Each box becomes one palette colour, and each colour stands for about the same number of pixels.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 3,
  "sentence": 0,
  "start": 75.877,
  "end": 81.154,
  "text": "He found pictures could drop to 8 bits per pixel with little visible loss.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 84.139,
  "end": 88.625,
  "text": "When a smooth sky turns into stripes, the obvious fix is more colours.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 89.421,
  "end": 95.489,
  "text": "There is another way: keep the error, and spread it where the eye will average it out.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 98.475,
  "end": 104.808,
  "text": "In 1973, B. E. Bayer published a pattern for this.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 105.604,
  "end": 111.145,
  "text": "Compare each pixel with a threshold from a small grid that repeats across the image.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 112.637,
  "end": 117.914,
  "text": "With an 8 by 8 grid, black and white alone can show 65 levels of grey.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 120.9,
  "end": 130.135,
  "text": "In the mid-1970s, Floyd and Steinberg passed each pixel's rounding error on to the neighbours still to be drawn.",
  "syllables": 35,
  "seconds": 9.235,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 131.628,
  "end": 133.739,
  "text": "Seven sixteenths go to the right.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 134.535,
  "end": 137.437,
  "text": "Three, five and one sixteenths go to the row below.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 138.93,
  "end": 144.471,
  "text": "The noise is fine enough that the eye blends it back into the colour that was meant.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 147.456,
  "end": 155.108,
  "text": "A third way uses a grid of thresholds spread out evenly, built by Robert Ulichney's void-and-cluster method.",
  "syllables": 29,
  "seconds": 7.652,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 156.601,
  "end": 159.503,
  "text": "It reads as fine grain instead of a pattern.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 162.489,
  "end": 173.307,
  "text": "Which palette colour is nearest depends on how you measure. raw-native measures in Oklab, a colour space designed so that equal steps look roughly equal.",
  "syllables": 41,
  "seconds": 10.818,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 176.292,
  "end": 179.723,
  "text": "raw-native's dither pass runs on the graphics card.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 1,
  "start": 180.519,
  "end": 192.392,
  "text": "For two palettes, it picks the same colour as the slow reference for every one of 16,777,216 colours.",
  "syllables": 45,
  "seconds": 11.873,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 193.885,
  "end": 205.494,
  "text": "BRender, from 1998, kept its textures the same way: each texel is an 8-bit index into a 256-colour palette.",
  "syllables": 44,
  "seconds": 11.609,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 0,
  "start": 208.48,
  "end": 209.535,
  "text": "Two things to keep.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 1,
  "start": 210.332,
  "end": 212.706,
  "text": "Pick the colours where the pixels are.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 2,
  "start": 213.502,
  "end": 217.724,
  "text": "Spend the error where the eye averages it away.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 1,
  "sentence": 0,
  "start": 219.217,
  "end": 222.911,
  "text": "The voice you heard is a synthesized version of mine.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 1,
  "sentence": 1,
  "start": 223.707,
  "end": 227.929,
  "text": "Every number on screen links to its source under the video.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 }
]
