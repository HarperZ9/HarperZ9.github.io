[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.5,
  "end": 7.083,
  "text": "Colour on a budget.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 10.082,
  "end": 19.581,
  "text": "In 1987, an IBM PC with VGA graphics had a mode of 320 by 200 pixels, one byte each.",
  "syllables": 36,
  "seconds": 9.499,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 21.081,
  "end": 34.009,
  "text": "A byte holds 256 values, so the screen showed 256 colours at once, each one picked from a palette of 262,144.",
  "syllables": 49,
  "seconds": 12.929,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "predict": 0,
  "start": 37.009,
  "end": 42.286,
  "text": "A photograph has thousands of colours. Which 256 would you keep?",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 44.786,
  "end": 51.91,
  "text": "In 1982, Paul Heckbert described a way to choose them, called median cut.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 53.409,
  "end": 57.103,
  "text": "Put every colour in the picture into a box.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 1,
  "start": 57.903,
  "end": 66.61,
  "text": "Cut the box in two at the median of its longest side, and keep cutting the biggest piece until there are 256 boxes.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 68.11,
  "end": 74.442,
  "text": "Each box becomes one palette colour, and each colour stands for about the same number of pixels.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 3,
  "sentence": 0,
  "start": 75.942,
  "end": 81.219,
  "text": "He found pictures could drop to 8 bits per pixel with little visible loss.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 84.219,
  "end": 88.704,
  "text": "When a smooth sky turns into stripes, the obvious fix is more colours.",
  "syllables": 17,
  "seconds": 4.485,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 1,
  "start": 89.504,
  "end": 95.572,
  "text": "There is another way: keep the error, and spread it where the eye will average it out.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 98.572,
  "end": 104.904,
  "text": "In 1973, B. E. Bayer published a pattern for this.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 1,
  "start": 105.704,
  "end": 111.245,
  "text": "Compare each pixel with a threshold from a small grid that repeats across the image.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 112.745,
  "end": 118.022,
  "text": "With an 8 by 8 grid, black and white alone can show 65 levels of grey.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 121.021,
  "end": 129.992,
  "text": "In the mid-1970s, Floyd and Steinberg passed each pixel's rounding error on to the neighbours not yet drawn.",
  "syllables": 34,
  "seconds": 8.971,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 131.492,
  "end": 133.603,
  "text": "Seven sixteenths go to the right.",
  "syllables": 8,
  "seconds": 2.111,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 1,
  "start": 134.402,
  "end": 137.305,
  "text": "Three, five and one sixteenths go to the row below.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 2,
  "sentence": 0,
  "start": 138.805,
  "end": 144.345,
  "text": "The noise is fine enough that the eye blends it back into the colour that was meant.",
  "syllables": 21,
  "seconds": 5.541,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 147.345,
  "end": 156.052,
  "text": "A third way uses a grid of thresholds with no clumps and no repeats you can see, built by Robert Ulichney's void-and-cluster method.",
  "syllables": 33,
  "seconds": 8.707,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 157.552,
  "end": 160.454,
  "text": "It reads as fine grain instead of a pattern.",
  "syllables": 11,
  "seconds": 2.902,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 163.453,
  "end": 174.271,
  "text": "Which palette colour is nearest depends on how you measure. raw-native measures in Oklab, a colour space designed so that equal steps look roughly equal.",
  "syllables": 41,
  "seconds": 10.818,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 0,
  "start": 177.271,
  "end": 180.701,
  "text": "raw-native's dither pass runs on the graphics card.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 0,
  "sentence": 1,
  "start": 181.501,
  "end": 193.374,
  "text": "For two palettes, it picks the same colour as the slow reference for every one of 16,777,216 colours.",
  "syllables": 45,
  "seconds": 11.873,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 8,
  "line": 1,
  "sentence": 0,
  "start": 194.874,
  "end": 206.483,
  "text": "BRender, from 1998, kept its textures the same way: each texel is an 8-bit index into a 256-colour palette.",
  "syllables": 44,
  "seconds": 11.609,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 0,
  "start": 209.483,
  "end": 210.538,
  "text": "Two things to keep.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 1,
  "start": 211.338,
  "end": 213.712,
  "text": "Pick the colours where the pixels are.",
  "syllables": 9,
  "seconds": 2.375,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 0,
  "sentence": 2,
  "start": 214.512,
  "end": 218.734,
  "text": "Spend the error where the eye averages it away.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 1,
  "sentence": 0,
  "start": 220.234,
  "end": 223.928,
  "text": "The voice you heard is a synthesized version of mine.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 9,
  "line": 1,
  "sentence": 1,
  "start": 224.727,
  "end": 228.949,
  "text": "Every number on screen links to its source under the video.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 }
]
