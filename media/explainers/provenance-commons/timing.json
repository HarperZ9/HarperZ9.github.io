[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.328,
  "end": 6.911,
  "text": "Provenance and the commons.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 8.239,
  "end": 14.043,
  "text": "A commons is anything people share and draw from, like open data or open source code.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 14.752,
  "end": 16.335,
  "text": "What keeps it usable?",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 18.99,
  "end": 22.42,
  "text": "Start with a small compression library called xz.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 23.748,
  "end": 29.553,
  "text": "In 2022 its maintainer wrote that it was an unpaid hobby project.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 30.881,
  "end": 35.894,
  "text": "A helpful newcomer had been sending patches since 2021.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 36.602,
  "end": 42.407,
  "text": "Within months, the maintainer called the newcomer practically a co-maintainer.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 3,
  "sentence": 0,
  "start": 43.735,
  "end": 49.539,
  "text": "In February 2024, the newcomer signed and shipped a new release.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 4,
  "sentence": 0,
  "start": 50.867,
  "end": 56.144,
  "text": "Part of a backdoor sat only in the release download, and not in the public source.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "predict": 0,
  "start": 57.472,
  "end": 62.221,
  "text": "How could anyone downstream have checked that the download matched the source?",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 5,
  "sentence": 0,
  "start": 64.721,
  "end": 69.998,
  "text": "An engineer caught it because remote logins ran about half a second slow.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 72.654,
  "end": 79.514,
  "text": "In 1968, Garrett Hardin wrote that freedom in a commons brings ruin to all.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 80.842,
  "end": 87.174,
  "text": "Many readers took the lesson that a commons needs a private owner or an outside ruler.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 88.502,
  "end": 93.515,
  "text": "Hardin himself asked for coercion agreed on by the people affected.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 96.171,
  "end": 104.086,
  "text": "Elinor Ostrom compared shared fisheries, forests and irrigation systems that lasted with ones that failed.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 105.414,
  "end": 109.372,
  "text": "In the ones that lasted she found eight design principles.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 110.7,
  "end": 115.449,
  "text": "Most of the people the rules affect take part in making and changing them.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 3,
  "sentence": 0,
  "start": 116.777,
  "end": 122.846,
  "text": "The people who watch for cheating are the users, or people the users can hold to account.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 4,
  "sentence": 0,
  "start": 124.173,
  "end": 130.506,
  "text": "A review of over a hundred studies found that about two thirds supported her principles.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 5,
  "sentence": 0,
  "start": 131.834,
  "end": 138.43,
  "text": "Across 178 forest user groups, more monitoring went with denser forest.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "predict": 0,
  "start": 141.085,
  "end": 147.682,
  "text": "When a dataset is copied to a popular site, how often does its licence survive the trip?",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 150.182,
  "end": 157.306,
  "text": "One audit traced the licences of 1,858 datasets used to train AI.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 158.634,
  "end": 163.383,
  "text": "On GitHub, 72 percent were listed with no licence at all.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 164.711,
  "end": 169.988,
  "text": "In 29 percent, the licence listed was looser than the author's own terms.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 3,
  "sentence": 0,
  "start": 171.315,
  "end": 176.593,
  "text": "Tracing each one back to where it was made cut the missing share to 30 percent.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 4,
  "sentence": 0,
  "start": 177.92,
  "end": 186.364,
  "text": "Meanwhile, in one year about 5 percent of a widely used training corpus became fully closed to AI crawlers.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 189.019,
  "end": 194.032,
  "text": "In software, a provenance record says where, when and how a release was built.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 195.36,
  "end": 199.054,
  "text": "With it, anyone can check a download against its source.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 201.71,
  "end": 204.348,
  "text": "Ostrom's cases are fisheries and forests.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 205.056,
  "end": 208.486,
  "text": "Applying them to code and data is our inference.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 209.814,
  "end": 212.453,
  "text": "The licence audit counts missing records.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 213.161,
  "end": 214.744,
  "text": "It does not measure harm.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 0,
  "start": 216.072,
  "end": 220.03,
  "text": "And a provenance record alone would not have stopped xz.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 1,
  "start": 220.738,
  "end": 226.542,
  "text": "Most of the backdoor was in the public source, signed by a maintainer people trusted.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 229.198,
  "end": 230.253,
  "text": "Two things to keep.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 230.962,
  "end": 234.656,
  "text": "Record where a thing came from at the moment it is made.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 235.983,
  "end": 240.205,
  "text": "And let the people who depend on it make the rules and check them.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 0,
  "start": 241.533,
  "end": 245.227,
  "text": "The voice you heard is a synthesized version of mine.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 1,
  "start": 245.935,
  "end": 250.156,
  "text": "Every number on screen links to its source under the video.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 }
]
