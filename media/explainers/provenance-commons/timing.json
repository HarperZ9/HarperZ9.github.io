[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.247,
  "end": 6.83,
  "text": "Provenance and the commons.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 8.078,
  "end": 13.882,
  "text": "A commons is anything people share and draw from, like open data or open source code.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 14.548,
  "end": 16.131,
  "text": "What keeps it usable?",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 18.625,
  "end": 22.055,
  "text": "Start with a small compression library called xz.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 23.303,
  "end": 29.107,
  "text": "In 2022 its maintainer wrote that it was an unpaid hobby project.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 30.355,
  "end": 35.368,
  "text": "A helpful newcomer had been sending patches since 2021.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 36.033,
  "end": 41.838,
  "text": "Within months, the maintainer called the newcomer practically a co-maintainer.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 3,
  "sentence": 0,
  "start": 43.085,
  "end": 48.89,
  "text": "In February 2024, the newcomer signed and shipped a new release.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 4,
  "sentence": 0,
  "start": 50.137,
  "end": 55.414,
  "text": "Part of a backdoor sat only in the release download, and not in the public source.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 5,
  "sentence": 0,
  "start": 60.409,
  "end": 65.686,
  "text": "An engineer caught it because remote logins ran about half a second slow.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 68.18,
  "end": 75.04,
  "text": "In 1968, Garrett Hardin wrote that freedom in a commons brings ruin to all.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 76.288,
  "end": 82.62,
  "text": "Many readers took the lesson that a commons needs a private owner or an outside ruler.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 83.867,
  "end": 88.88,
  "text": "Hardin himself asked for coercion agreed on by the people affected.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 91.375,
  "end": 99.291,
  "text": "Elinor Ostrom compared shared fisheries, forests and irrigation systems that lasted with ones that failed.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 100.538,
  "end": 104.496,
  "text": "In the ones that lasted she found eight design principles.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 105.743,
  "end": 110.492,
  "text": "Most of the people the rules affect take part in making and changing them.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 3,
  "sentence": 0,
  "start": 111.739,
  "end": 117.808,
  "text": "The people who watch for cheating are the users, or people the users can hold to account.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 4,
  "sentence": 0,
  "start": 119.055,
  "end": 125.388,
  "text": "A review of over a hundred studies found that about two thirds supported her principles.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 5,
  "sentence": 0,
  "start": 126.635,
  "end": 133.231,
  "text": "Across 178 forest user groups, more monitoring went with denser forest.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 139.473,
  "end": 146.597,
  "text": "One audit traced the licences of 1,858 datasets used to train AI.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 147.844,
  "end": 152.594,
  "text": "On GitHub, 72 percent were listed with no licence at all.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 153.841,
  "end": 159.118,
  "text": "In 29 percent, the licence listed was looser than the author's own terms.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 3,
  "sentence": 0,
  "start": 160.365,
  "end": 165.642,
  "text": "Tracing each one back to where it was made cut the missing share to 30 percent.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 4,
  "sentence": 0,
  "start": 166.89,
  "end": 175.333,
  "text": "Meanwhile, in one year about 5 percent of a widely used training corpus became fully closed to AI crawlers.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 177.827,
  "end": 182.841,
  "text": "In software, a provenance record says where, when and how a release was built.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 184.088,
  "end": 187.782,
  "text": "With it, anyone can check a download against its source.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 190.276,
  "end": 192.915,
  "text": "Ostrom's cases are fisheries and forests.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 193.58,
  "end": 197.01,
  "text": "Applying them to code and data is our inference.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 198.257,
  "end": 200.896,
  "text": "The licence audit counts missing records.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 201.561,
  "end": 203.144,
  "text": "It does not measure harm.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 0,
  "start": 204.391,
  "end": 208.349,
  "text": "And a provenance record alone would not have stopped xz.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 1,
  "start": 209.014,
  "end": 214.819,
  "text": "Most of the backdoor was in the public source, signed by a maintainer people trusted.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 217.314,
  "end": 218.369,
  "text": "Two things to keep.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 219.034,
  "end": 222.728,
  "text": "Record where a thing came from at the moment it is made.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 223.975,
  "end": 228.197,
  "text": "And let the people who depend on it make the rules and check them.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 0,
  "start": 229.444,
  "end": 233.138,
  "text": "The voice you heard is a synthesized version of mine.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 1,
  "start": 233.803,
  "end": 238.025,
  "text": "Every number on screen links to its source under the video.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 }
]
