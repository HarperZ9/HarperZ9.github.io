[
 {
  "segment": 0,
  "line": 0,
  "sentence": 0,
  "start": 5.332,
  "end": 6.915,
  "text": "Provenance and the commons.",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 0,
  "start": 8.246,
  "end": 14.051,
  "text": "A commons is anything people share and draw from, like open data or open source code.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 0,
  "line": 1,
  "sentence": 1,
  "start": 14.761,
  "end": 16.344,
  "text": "What keeps it usable?",
  "syllables": 6,
  "seconds": 1.583,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 0,
  "sentence": 0,
  "start": 19.007,
  "end": 22.437,
  "text": "Start with a small compression library called xz.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 1,
  "sentence": 0,
  "start": 23.769,
  "end": 29.574,
  "text": "In 2022 its maintainer wrote that it was an unpaid hobby project.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 0,
  "start": 30.905,
  "end": 35.918,
  "text": "A helpful newcomer had been sending patches since 2021.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 2,
  "sentence": 1,
  "start": 36.628,
  "end": 42.433,
  "text": "Within months, the maintainer called the newcomer practically a co-maintainer.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 3,
  "sentence": 0,
  "start": 43.765,
  "end": 49.57,
  "text": "In February 2024, the newcomer signed and shipped a new release.",
  "syllables": 22,
  "seconds": 5.805,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 4,
  "sentence": 0,
  "start": 50.901,
  "end": 55.914,
  "text": "Part of the backdoor was in the release download and missing from the public source.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "predict": 0,
  "start": 57.246,
  "end": 61.995,
  "text": "How could anyone downstream have checked that the download matched the source?",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 1,
  "line": 5,
  "sentence": 0,
  "start": 64.495,
  "end": 69.772,
  "text": "An engineer caught it because remote logins ran about half a second slow.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 0,
  "sentence": 0,
  "start": 72.435,
  "end": 79.295,
  "text": "In 1968, Garrett Hardin wrote that freedom in a commons brings ruin to all.",
  "syllables": 26,
  "seconds": 6.86,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 1,
  "sentence": 0,
  "start": 80.627,
  "end": 86.959,
  "text": "Many readers took the lesson that a commons needs a private owner or an outside ruler.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 2,
  "line": 2,
  "sentence": 0,
  "start": 88.291,
  "end": 93.304,
  "text": "Hardin himself asked for coercion agreed on by the people affected.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 0,
  "sentence": 0,
  "start": 95.967,
  "end": 103.883,
  "text": "Elinor Ostrom compared shared fisheries, forests and irrigation systems that lasted with ones that failed.",
  "syllables": 30,
  "seconds": 7.916,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 1,
  "sentence": 0,
  "start": 105.214,
  "end": 109.172,
  "text": "In the ones that lasted she found eight design principles.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 2,
  "sentence": 0,
  "start": 110.504,
  "end": 115.253,
  "text": "Most of the people the rules affect take part in making and changing them.",
  "syllables": 18,
  "seconds": 4.749,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 3,
  "sentence": 0,
  "start": 116.584,
  "end": 122.653,
  "text": "The people who watch for cheating are the users, or people the users can hold to account.",
  "syllables": 23,
  "seconds": 6.069,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 4,
  "sentence": 0,
  "start": 123.985,
  "end": 130.317,
  "text": "A review of over a hundred studies found that about two thirds supported her principles.",
  "syllables": 24,
  "seconds": 6.332,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 3,
  "line": 5,
  "sentence": 0,
  "start": 131.649,
  "end": 138.245,
  "text": "Across 178 forest user groups, more monitoring went with denser forest.",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "predict": 0,
  "start": 140.908,
  "end": 147.504,
  "text": "When a dataset is copied to a popular site, how often does its licence survive the trip?",
  "syllables": 25,
  "seconds": 6.596,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 0,
  "sentence": 0,
  "start": 150.004,
  "end": 157.128,
  "text": "One audit traced the licences of 1,858 datasets used to train AI.",
  "syllables": 27,
  "seconds": 7.124,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 1,
  "sentence": 0,
  "start": 158.46,
  "end": 163.473,
  "text": "On GitHub, 72 percent were listed as licence unspecified.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 2,
  "sentence": 0,
  "start": 164.805,
  "end": 170.082,
  "text": "In 29 percent, the licence listed was looser than the author's own terms.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 3,
  "sentence": 0,
  "start": 171.413,
  "end": 176.69,
  "text": "Tracing each one back to where it was made cut the missing share to 30 percent.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 4,
  "line": 4,
  "sentence": 0,
  "start": 178.022,
  "end": 186.465,
  "text": "Meanwhile, in one year about 5 percent of a widely used training corpus became fully closed to AI crawlers.",
  "syllables": 32,
  "seconds": 8.443,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 0,
  "sentence": 0,
  "start": 189.128,
  "end": 194.141,
  "text": "In software, a provenance record says where, when and how a release was built.",
  "syllables": 19,
  "seconds": 5.013,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 5,
  "line": 1,
  "sentence": 0,
  "start": 195.473,
  "end": 199.167,
  "text": "With it, anyone can check a download against its source.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 0,
  "start": 201.83,
  "end": 204.468,
  "text": "Ostrom's cases are fisheries and forests.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 0,
  "sentence": 1,
  "start": 205.178,
  "end": 208.609,
  "text": "Applying them to code and data is our inference.",
  "syllables": 13,
  "seconds": 3.43,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 0,
  "start": 209.94,
  "end": 212.579,
  "text": "The licence audit counts missing records.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 1,
  "sentence": 1,
  "start": 213.289,
  "end": 215.927,
  "text": "Harm is a separate measurement.",
  "syllables": 10,
  "seconds": 2.639,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 0,
  "start": 217.259,
  "end": 221.217,
  "text": "And most of the xz backdoor was in the public source itself.",
  "syllables": 15,
  "seconds": 3.958,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 6,
  "line": 2,
  "sentence": 1,
  "start": 221.927,
  "end": 227.204,
  "text": "A maintainer people trusted signed it, so a build record would have matched.",
  "syllables": 20,
  "seconds": 5.277,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 0,
  "start": 229.867,
  "end": 230.922,
  "text": "Two things to keep.",
  "syllables": 4,
  "seconds": 1.055,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 0,
  "sentence": 1,
  "start": 231.632,
  "end": 235.326,
  "text": "Record where a thing came from at the moment it is made.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 1,
  "sentence": 0,
  "start": 236.658,
  "end": 240.879,
  "text": "And let the people who depend on it make the rules and check them.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 0,
  "start": 242.211,
  "end": 245.905,
  "text": "The voice you heard is a synthesized version of mine.",
  "syllables": 14,
  "seconds": 3.694,
  "provisional": true,
  "accepted": true
 },
 {
  "segment": 7,
  "line": 2,
  "sentence": 1,
  "start": 246.615,
  "end": 250.837,
  "text": "Every number on screen links to its source under the video.",
  "syllables": 16,
  "seconds": 4.222,
  "provisional": true,
  "accepted": true
 }
]
