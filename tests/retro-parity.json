{
 "about": "Every control of the Retro Studio (retro.html and the controls system/retro-studio.js builds while it runs) against the shader room of The Playground. A control is either mapped to the room control that does its job (tests/retro-parity.cjs opens the room and checks it is there) or listed under missing with the issue that tracks it. retro.html may not redirect to the room while missing is not empty.",
 "issue": "https://github.com/HarperZ9/HarperZ9.github.io/issues/553",
 "mapped": {
  "re-animate": {
   "room": "[data-run]",
   "how": "Pause and Run",
   "act": {
    "do": "click",
    "sees": "state",
    "after": [
     [
      "click",
      "[data-run]"
     ]
    ]
   }
  },
  "data-src=shader": {
   "room": ".shd-frame",
   "how": "the room is the studio's shader source; its starts pick the shader",
   "act": {
    "do": "set",
    "target": "#shd-start",
    "value": "bands"
   }
  },
  "re-preset": {
   "room": "#shd-preset",
   "how": "the preset library, after its press",
   "act": {
    "do": "set",
    "value": "Gold Ground, Lamp Moving"
   }
  },
  "re-code": {
   "room": "#shd-src",
   "act": {
    "do": "type",
    "value": "void mainImage(out vec4 O, in vec2 U){ O = vec4(U.x / iResolution.x, 0.3, 0.6, 1.0); }"
   }
  },
  "re-run": {
   "room": "#shd-src",
   "how": "the room compiles as the visitor types, after a quarter second's pause",
   "act": {
    "do": "type",
    "value": "void mainImage(out vec4 O, in vec2 U){ O = vec4(0.2, U.y / iResolution.y, 0.5, 1.0); }"
   }
  },
  "re-knobA": {
   "room": "#shd-k0",
   "act": {
    "do": "set",
    "target": "#shd-k0",
    "value": 0.9,
    "sees": [
     "frame",
     "state"
    ]
   }
  },
  "re-knobB": {
