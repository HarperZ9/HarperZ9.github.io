 "dynamic": {
  "about": "The controls retro-studio.js makes with document.createElement while it runs, each found by a line of its code. creates is how many createElement calls of a button, input or select that entry accounts for; the test holds their sum to the file's count, so a new run-time control fails the test until it is listed.",
  "entries": {
   "dyn:fx-chip": {
    "find": "b.className = \"re-chip\"; b.type = \"button\"; b.textContent = m.label;",
    "creates": 1
   },
   "dyn:fx-amount": {
    "find": "sl.setAttribute(\"aria-label\", m.label + \" amount\");",
    "creates": 1
   },
   "dyn:vibe": {
    "find": "b.className = \"re-vibe\";",
    "creates": 1
   },
   "dyn:sheet-cell": {
    "find": "const cell = document.createElement(\"button\");",
    "creates": 1
   },
   "dyn:layer-blend": {
    "find": "bl.className = \"re-in re-blend\";",
    "creates": 1
   },
   "dyn:layer-opacity": {
    "find": "op.className = \"re-op\"; op.title = \"layer opacity\";",
    "creates": 1
   },
   "dyn:layer-remove": {
    "find": "rm.className = \"re-chip re-rm\";",
    "creates": 1
   },
   "dyn:mod-depth": {
    "find": "sl.type = \"range\"; sl.min = \"-100\"; sl.max = \"100\";",
    "creates": 1
   },
   "dyn:mod-remove": {
    "find": "rm.className = \"re-btn re-rm\";",
    "creates": 1
   }
  }
 }
}
