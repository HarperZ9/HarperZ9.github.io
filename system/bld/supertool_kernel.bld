// Unified Multimedia Super-Tool BuildLang Kernel (compiled to zero-import WebAssembly).
// Provides deterministic Cauchy glass optics, Kubelka-Munk pigment reflectance,
// cellular sand/fluid transition rules, harmonic audio phase synthesis, and FNV-1a receipts.

pub fn xorshift32(s0: u32) -> u32 {
    let mut x: u32 = s0;
    if x == 0 {
        x = 2463534242;
    }
    x = x ^ (x << 13);
    x = x ^ (x >> 17);
    x = x ^ (x << 5);
    x
}

pub fn sand_density(mat: i32) -> i32 {
    if mat == 0 { return 0; }      // AIR
    if mat == 1 { return 4; }      // SAND
    if mat == 2 { return 2; }      // WATER
    if mat == 3 { return 1; }      // OIL
    if mat == 4 { return 0; }      // FIRE
    if mat == 5 { return 9; }      // WOOD
    if mat == 6 { return 9; }      // STONE
    if mat == 7 { return 9; }      // GLASS
    if mat == 8 { return 2; }      // INK
    if mat == 9 { return 2; }      // ACID
    if mat == 10 { return 0; }     // STEAM
    0
}

pub fn sand_can_displace(src: i32, dst: i32) -> i32 {
    let ds: i32 = sand_density(src);
    let dd: i32 = sand_density(dst);
    if dd >= 9 { return 0; }
    if ds > dd { return 1; }
    0
}

pub fn sand_thermal_react(mat: i32, heat: i32) -> i32 {
    if heat <= 0 { return mat; }
    if mat == 1 && heat >= 3 { return 7; }   // SAND + high heat -> GLASS
    if mat == 2 && heat >= 1 { return 10; }  // WATER + heat -> STEAM
    if mat == 3 && heat >= 1 { return 4; }   // OIL + heat -> FIRE
    if mat == 5 && heat >= 2 { return 4; }   // WOOD + heat -> FIRE
    mat
}

pub fn cauchy_ior(lambda_um: f64, a_coef: f64, b_coef: f64) -> f64 {
    let l2: f64 = lambda_um * lambda_um;
    if l2 <= 0.0001 {
        return a_coef;
    }
    a_coef + (b_coef / l2)
}

pub fn fresnel_schlick(cos_theta: f64, f0: f64) -> f64 {
    let mut c: f64 = 1.0 - cos_theta;
    if c < 0.0 { c = 0.0; }
    if c > 1.0 { c = 1.0; }
    let c2: f64 = c * c;
    f0 + (1.0 - f0) * (c2 * c2 * c)
}

fn bld_sqrt(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    let mut g: f64 = x;
    if g < 1.0 { g = 1.0; }
    let mut i: i32 = 0;
    while i < 16 {
        g = 0.5 * (g + x / g);
        i = i + 1;
    }
    g
}

pub fn km_reflectance(k_abs: f64, s_scat: f64) -> f64 {
    if s_scat <= 1.0e-9 {
        return 0.0;
    }
    let ks: f64 = k_abs / s_scat;
    let r: f64 = 1.0 + ks - bld_sqrt(ks * ks + 2.0 * ks);
    if r < 0.0 { return 0.0; }
    if r > 1.0 { return 1.0; }
    r
}

pub fn scene_fnv1a(seed: u32, width: u32, height: u32, tick: u32) -> u32 {
    let mut h: u32 = 2166136261;
    h = (h ^ seed) * 16777619;
    h = (h ^ width) * 16777619;
    h = (h ^ height) * 16777619;
    h = (h ^ tick) * 16777619;
    h
}

fn main() -> i32 {
    let ior: f64 = cauchy_ior(0.55, 1.5046, 0.00420);
    let r: f64 = km_reflectance(0.25, 1.0);
    let ok_sand: i32 = sand_can_displace(1, 2);
    let ok_glass: i32 = sand_thermal_react(1, 3);
    if ior > 1.5 && r > 0.4 && ok_sand == 1 && ok_glass == 7 {
        return 0;
    }
    1
}
