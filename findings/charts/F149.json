   "title": "The design: three models of the same rise, a shuffle control and a planted doubling.",
   "takeaway": "The authors' model gave ratios of 2.19 and 2.84. Weighted by citations they were 1.77 and 1.54, with intervals that include 1. A planted doubling cleared 1 only 0.425 of the time.",
   "n": "268 study-year rates from 11 function and 7 structure focal studies; 1000 year shuffles; 120 planted simulations per truth",
   "steps": [
    {
     "kind": "data",
     "label": "The deposited rate table",
     "detail": "268 rates of unsupported citations, one per focal study and citing year, for 11 function and 7 structure focal studies."
    },
    {
     "kind": "measure",
     "label": "Rebuilt denominators",
     "detail": "The table holds rates only. Citation counts were rebuilt from the paper's printed numerators. 143 of 169 nonzero rates gave a whole number."
    },
    {
     "kind": "measure",
     "label": "Three models",
     "detail": "The authors' count model with every study-year weighted equally, a within-study model with one level per focal study, and a share model weighted by citations."
    },
    {
     "kind": "control",
     "label": "Years shuffled inside each study",
     "detail": "1000 shuffles. A real ratio or slope has to beat the 95th percentile of the shuffled ones."
    },
    {
     "kind": "planted",
     "label": "Planted truth of 1 and of 2",
     "detail": "New counts drawn on the real studies, years and denominators, 120 simulations per truth."
    },
    {
     "kind": "verdict",
     "holds": true,
     "label": "Planted check",
     "yes": "held",
     "detail": "A flat truth was called a rise 0.092 of the time, limit 0.15. A doubling came back as 2.11 and was covered 0.89 of the time, above the bar of 0.8. The intervals claim 95 percent, so they run somewhat too narrow."
    },
    {
     "kind": "verdict",
     "holds": false,
     "label": "Doubling, authors' model, function",
     "no": "failed",
     "detail": "Ratio 2.19. The interval starts at 0.86, below 1."
    },
    {
     "kind": "verdict",
     "holds": true,
     "label": "Doubling, authors' model, structure",
     "yes": "held",
     "detail": "Ratio 2.84. The interval starts at 1.18."
    },
    {
     "kind": "verdict",
     "holds": true,
     "label": "Rise inside studies, both groups",
     "yes": "held",
     "detail": "Slopes 0.044 and 0.054 per year, above the shuffle cuts."
    },
    {
     "kind": "verdict",
     "holds": false,
     "label": "Doubling, citation-weighted, both groups",
     "no": "failed",
     "detail": "Intervals start at 0.52 and 0.85, below 1."
    }
   ]
