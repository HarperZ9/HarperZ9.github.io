   "title": "From 241 scanned adults to one equivalence decision.",
   "takeaway": "187 of 241 participants reached the test, and the 90% interval of partial r, −0.129 to 0.117, sat inside −0.20 to 0.20.",
   "n": "241 participants processed; 187 analysed",
   "steps": [
    {
     "kind": "data",
     "label": "241 adults with resting scans",
     "detail": "All 241 were processed with no processing error. Most had four resting runs."
    },
    {
     "kind": "measure",
     "label": "Motion rule: 224 kept",
     "detail": "17 had fewer than two usable runs after high-motion frames were removed."
    },
    {
     "kind": "measure",
     "label": "Trauma questionnaire: 187 kept",
     "detail": "16 had no questionnaire record and 21 had no total score."
    },
    {
     "kind": "measure",
     "label": "Partial r with six covariates",
     "detail": "Trauma total against the strength of the amygdala to frontal medial cortex link at rest."
    },
    {
     "kind": "control",
     "label": "Shuffle control",
     "detail": "Trauma scores shuffled across people 10,000 times. The observed value sat at percentile 47."
    },
    {
     "kind": "rule",
     "label": "Rule: 90% interval inside −0.20 to 0.20",
     "detail": "Written before the data were analysed. An interval inside the bound excludes effects of that size or larger."
    },
    {
     "kind": "verdict",
     "holds": true,
     "label": "No meaningful association",
     "yes": "bound met",
     "no": "bound not met",
     "detail": "Partial r −0.006, 90% interval −0.129 to 0.117. No known effect was planted, so the pipeline's sensitivity is untested."
    }
   ]
  },
