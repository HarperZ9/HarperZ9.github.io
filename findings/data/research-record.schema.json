{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-record/1",
  "title": "Research record",
  "description": "One record per research page: a finding write-up, an experiment, the scoreboard or an investigation such as Who Knew First. Derived values (standing, back-links, counts) are computed by the renderer and never stored. See DATA.md.",
  "type": "object",
  "required": ["schema", "document", "claims", "references", "corrections", "versions", "verified"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "research-record/1"},
    "built": {"type": "string", "description": "ISO date the record was generated, and from which inputs."},
    "inputs": {"type": "array", "items": {"type": "string"}, "description": "Internal input paths. Stripped before publishing."},
    "document": {"$ref": "#/$defs/document"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "corrections": {"type": "array", "items": {"$ref": "#/$defs/correction"}},
    "versions": {"type": "array", "items": {"$ref": "#/$defs/version"}},
    "grade": {"$ref": "#/$defs/grade"},
    "reproduce": {"$ref": "#/$defs/reproduce"},
    "verified": {"$ref": "#/$defs/verified"},
    "categories": {"type": "array", "items": {"$ref": "#/$defs/category"}},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "plans": {"type": "array", "items": {"$ref": "#/$defs/plan"}}
  },
  "$defs": {
    "basis": {"enum": ["observed", "reported", "inferred", "proposed", "unknown"]},
    "outcome": {"enum": ["held", "null", "inconclusive", "failed", "mixed", "pending"]},
    "standing": {"enum": ["held", "extended", "narrowed", "questioned", "refuted", "retracted", "superseded"]},
    "access": {"enum": ["run", "read", "snippet", "recall", "not_read", "unrecorded"]},
    "tier": {"enum": ["A", "B*", "B", "C", "D", "E"]},
    "rung": {"enum": ["lead", "hypothesis", "thesis", "conjecture", "theorem", "law candidate", "killed"]},
    "position": {"enum": ["lead", "parity", "behind", "absent", "unmeasured", "ahead_unverified", "not_comparable"]},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$|^earlier$|^target$"},
    "document": {
      "type": "object",
      "required": ["id", "kind", "title", "standfirst"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "description": "F-number, 'scoreboard', or a series slug such as 'who-knew-first'."},
        "kind": {"enum": ["finding", "experiment", "scoreboard", "investigation"]},
        "title": {"type": "string"},
        "standfirst": {"type": "string"},
        "date_found": {"$ref": "#/$defs/date"},
        "fields": {"type": "array", "items": {"type": "string"}},
        "tier": {"$ref": "#/$defs/tier"},
        "tier_reason": {"type": "string"},
        "rung": {"$ref": "#/$defs/rung"},
        "rung_reason": {"type": "string"},
        "outcome": {"$ref": "#/$defs/outcome"},
        "bound": {"type": "string", "description": "For a null: what the result rules out and what it leaves open."},
        "objection": {"type": "string", "description": "The strongest case against. Register: reviewer_attack."},
        "objection_source": {"type": "string"},
        "would_change": {"type": "string", "description": "What would raise or overturn the call. Register: raise_tier."},
        "sections": {"type": "array", "items": {
          "type": "object", "required": ["id", "title", "role"], "additionalProperties": false,
          "properties": {
            "id": {"type": "string"}, "title": {"type": "string"},
            "role": {"enum": ["lead", "argument", "evidence"]},
            "paragraphs": {"type": "array", "items": {"type": "string"}, "description": "Prose. A claim is marked with {c3}...{/c3}; a correction with {x2}."}
          }}}
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "basis"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^c[0-9]+$"},
        "text": {"type": "string"},
        "section": {"type": "string"},
        "basis": {"$ref": "#/$defs/basis"},
        "outcome": {"$ref": "#/$defs/outcome"},
        "bound": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "refs": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^e[0-9]+$"},
        "kind": {"enum": ["number", "control", "prereg", "dataset", "rerun", "derivation"]},
        "label": {"type": "string"},
        "value": {"type": "string"},
        "interval": {"type": "string"},
        "denominator": {"type": "string"},
        "control": {"type": "string"},
        "check": {"type": "object", "additionalProperties": false, "properties": {
          "by": {"type": "string"}, "date": {"$ref": "#/$defs/date"}, "result": {"enum": ["match", "mismatch", "not_checked"]}, "note": {"type": "string"}}},
        "file_public": {"type": "string"},
        "file_internal": {"type": "string", "description": "Stripped before publishing."}
      }
    },
    "reference": {
      "type": "object",
      "required": ["id", "kind", "title", "access"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^r[0-9]+$"},
        "key": {"type": "string", "description": "Display key: F95, R-OAI-HUB1, Anderegg 2020."},
        "kind": {"enum": ["finding", "paper", "dataset", "record", "web", "code", "release"]},
        "title": {"type": "string"},
        "target": {"type": "string", "description": "F-number, DOI or URL."},
        "access": {"$ref": "#/$defs/access"},
        "access_note": {"type": "string"},
        "accessed": {"$ref": "#/$defs/date"},
        "licence": {"type": "string"}
      }
    },
    "relation": {
      "type": "object",
      "required": ["from", "to", "type", "date"],
      "additionalProperties": false,
      "description": "A later record's treatment of an earlier finding. Standing is the most severe relation into a finding.",
      "properties": {
        "from": {"type": "string"}, "to": {"type": "string"},
        "type": {"$ref": "#/$defs/standing"},
        "scope": {"type": "string", "description": "The part treated: 'test A', 'within-species sign'."},
        "date": {"$ref": "#/$defs/date"},
        "note": {"type": "string"},
        "record": {"type": "string", "description": "Correction record key such as PU30-06."}
      }
    },
    "correction": {
      "type": "object",
      "required": ["id", "date", "type", "after", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^x[0-9]+$"},
        "date": {"$ref": "#/$defs/date"},
        "target": {"type": "string", "description": "A claim id, a section id or 'document'."},
        "type": {"enum": ["number", "wording", "scope", "tier", "status", "retraction"]},
        "before": {"type": "string"},
        "after": {"type": "string"},
        "reason": {"type": "string"},
        "found_by": {"type": "string"},
        "record": {"type": "string"}
      }
    },
    "version": {
      "type": "object", "required": ["n", "date", "what"], "additionalProperties": false,
      "properties": {"n": {"type": "integer"}, "date": {"$ref": "#/$defs/date"}, "what": {"type": "string"}, "hash": {"type": "string"}}
    },
    "grade": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "lowers": {"type": "array", "items": {"$ref": "#/$defs/reason"}},
        "holds": {"type": "array", "items": {"$ref": "#/$defs/reason"}}
      }
    },
    "reason": {
      "type": "object", "required": ["domain", "text"], "additionalProperties": false,
      "properties": {
        "domain": {"enum": ["blinding", "imprecision", "indirectness", "missing control", "measurement", "novelty", "single source", "preregistration", "control", "replication", "open data", "scoring"]},
        "text": {"type": "string"},
        "from": {"type": "string", "description": "The register field it was derived from."}
      }
    },
    "reproduce": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "data": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {
          "name": {"type": "string"}, "licence": {"type": "string"}, "url": {"type": "string"}}}},
        "prereg": {"type": "object", "additionalProperties": false, "properties": {"hash": {"type": "string"}, "plan": {"type": "string"}, "path_internal": {"type": "string"}}},
        "steps": {"type": "array", "items": {"type": "string"}},
        "cost": {"type": "string"},
        "not_rerun": {"type": "string"}
      }
    },
    "verified": {
      "type": "object", "required": ["date", "checks"], "additionalProperties": false,
      "properties": {
        "date": {"$ref": "#/$defs/date"},
        "checks": {"type": "array", "items": {"type": "object", "required": ["what", "result"], "additionalProperties": false, "properties": {
          "what": {"type": "string"}, "by": {"type": "string"}, "result": {"type": "string"}}}},
        "not_checked": {"type": "array", "items": {"type": "string"}}
      }
    },
    "category": {
      "type": "object", "required": ["id", "name"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "field": {"type": "string"},
        "trend": {"type": "array", "items": {"type": "array", "items": {"type": "integer"}}, "description": "Per checkpoint: [measured lead or level, ours measured only, target]."}}
    },
    "row": {
      "type": "object", "required": ["id", "category", "axis", "position"], "additionalProperties": false,
      "description": "A scoreboard row is a claim about two programs on one axis.",
      "properties": {
        "id": {"type": "string"}, "category": {"type": "string"}, "axis": {"type": "string"},
        "unit": {"type": "string"}, "better": {"type": "string"},
        "position": {"$ref": "#/$defs/position"},
        "leader": {"type": "object", "additionalProperties": false, "properties": {
          "name": {"type": "string"}, "value": {"type": "string"}, "access": {"$ref": "#/$defs/access"}, "source": {"type": "string"}}},
        "ours": {"type": "object", "additionalProperties": false, "properties": {
          "value": {"type": "string"}, "basis": {"$ref": "#/$defs/basis"}, "evidence": {"type": "string"}}},
        "gap": {"type": "string"}, "next": {"type": "string"}, "bench": {"type": "string"},
        "since": {"$ref": "#/$defs/date"}
      }
    },
    "plan": {
      "type": "object", "required": ["id", "target"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "row": {"type": "string"}, "name": {"type": "string"},
        "target": {"type": "string"}, "experiment": {"type": "string"}, "kill": {"type": "string"}}
    }
  }
}
