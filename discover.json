{
  "origin": "https://harperz9.github.io",
  "scope": "sitemap",
  "exclude": [
    "tests/**",
    "home/**",
    "node_modules/**",
    "img/og/_card.html",
    "frontier-safety.html",
    "frontier-safety/**",
    "checking-the-machines.html",
    "briefings/2026-08-26-openai-hugging-face-incident/**"
  ],
  "notes": {
    "exclude": "frontier-safety and checking-the-machines are written by builders that pin their own bytes (tools/build_frontier_safety_briefing.py, tools/build_checking_machines.py); their Article markup belongs in those builders. The incident briefing's bytes are pinned by its own build.json receipt; its social card belongs in that build. img/og/_card.html is the card render template, not a page.",
    "tools": "One record per tool. tools/structured_data.py reads this list for the SoftwareApplication markup, and discover checks llms.txt, llms-full.txt and the markup against it. `discover site . --online` compares each version with its registry."
  },
  "tools": [
    {
      "name": "Flywheel",
      "repo": "flywheel",
      "page": "flywheel.html",
      "version": "1.9.0",
      "registry": "pypi",
      "package": "flywheel-verify",
      "downloadUrl": "https://pypi.org/project/flywheel-verify/",
      "install": "python -m pip install flywheel-verify",
      "license": "https://github.com/HarperZ9/flywheel/blob/main/LICENSE",
      "os": "Windows, macOS, Linux",
      "category": "DeveloperApplication"
    },
    {
      "name": "Articulate",
      "repo": "articulate",
      "page": "articulate.html",
      "version": "0.16.0",
      "registry": "pypi",
      "package": "articulate-writing",
      "downloadUrl": "https://pypi.org/project/articulate-writing/",
      "install": "python -m pip install articulate-writing",
      "license": "https://github.com/HarperZ9/articulate/blob/main/LICENSE",
      "os": "Windows, macOS, Linux",
      "category": "DeveloperApplication"
    },
    {
      "name": "Daylight Commons",
      "repo": "daylight-commons",
      "version": "3.8.0",
      "registry": "github",
      "package": "HarperZ9/daylight-commons",
      "downloadUrl": "https://github.com/HarperZ9/daylight-commons/releases/latest",
      "license": "https://spdx.org/licenses/AGPL-3.0-only.html",
      "os": "Chrome, Edge, Brave, Firefox",
      "category": "BrowserApplication",
      "page": "daylight.html"
    },
    {
      "name": "EMET",
      "repo": "emet",
      "page": "emet.html",
      "version": "1.3.1",
