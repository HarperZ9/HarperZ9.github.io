      "category": "DeveloperApplication"
    },
    {
      "name": "BuildLang",
      "repo": "buildlang",
      "page": "buildlang.html",
      "version": "1.10.0",
      "registry": "github",
      "package": "HarperZ9/buildlang",
      "downloadUrl": "https://crates.io/crates/buildlang",
